<Window x:Class="ProfileSwitchChrome.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Antigravity Hub - Quản Trị Quota, Tài Khoản &amp; Chrome Workspaces"
        Height="760" Width="1120" MinHeight="560" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeWindowBg}"
        Foreground="{DynamicResource ThemeTextPrimary}"
        FontFamily="Segoe UI, Segoe UI Variable Text, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" 
                      ResizeBorderThickness="6" 
                      GlassFrameThickness="1" 
                      CornerRadius="0" 
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Hero Model Quota ProgressBar Style -->
        <Style x:Key="HeroQuotaProgressBar" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot" ClipToBounds="True">
                            <Border x:Name="PART_Track" Background="{DynamicResource ThemeProgressBarTrack}" CornerRadius="3"/>
                            <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left">
                                <Border Background="{TemplateBinding Foreground}" CornerRadius="3"/>
                            </Decorator>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hero Model Quota Item Template -->
        <DataTemplate x:Key="HeroModelQuotaItemTemplate">
            <Border Background="Transparent" CornerRadius="4" Padding="4,2" Margin="0,1,6,3" ToolTip="{Binding TooltipText}" Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeSecondaryBtnHoverBg}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0">
                            <TextBlock Text="{Binding ResetCountdownText}" FontSize="9.5" Foreground="#94A3B8" HorizontalAlignment="Right"
                                       Visibility="{Binding ResetCountdownVisibility}" Margin="0,0,0,1"/>
                            <TextBlock Text="{Binding PercentDisplay}" FontSize="10.5" Foreground="{Binding PercentForeground}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                    <ProgressBar Style="{StaticResource HeroQuotaProgressBar}" 
                                 Value="{Binding PercentValue, Mode=OneWay}" 
                                 Foreground="{Binding BarBrush}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <!-- Modern ScrollViewer ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="thumbBorder" Background="{DynamicResource ThemeScrollBarThumb}" CornerRadius="3.5" Margin="1,0,1,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource ThemeScrollBarThumbHover}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource ThemeNavActiveBorder}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="7"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border x:Name="thumbBorderH" Background="{DynamicResource ThemeScrollBarThumb}" CornerRadius="3.5" Margin="0,1,0,1"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="thumbBorderH" Property="Background" Value="{DynamicResource ThemeScrollBarThumbHover}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter TargetName="thumbBorderH" Property="Background" Value="{DynamicResource ThemeNavActiveBorder}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Clean ScrollViewer Style -->
        <Style TargetType="ScrollViewer">
            <Setter Property="PanningMode" Value="Both"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter Grid.Column="0" Grid.Row="0" Margin="{TemplateBinding Padding}"/>
                            <ScrollBar Grid.Column="1" Grid.Row="0" Name="PART_VerticalScrollBar"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                            <ScrollBar Grid.Column="0" Grid.Row="1" Name="PART_HorizontalScrollBar"
                                       Orientation="Horizontal"
                                       Value="{TemplateBinding HorizontalOffset}"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button (Modern Vibrant Emerald Gradient) -->
        <Style x:Key="PrimaryGreenBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#22E5A1" Offset="0.0"/>
                        <GradientStop Color="#0FB87F" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#10B981" BlurRadius="8" ShadowDepth="1.5" Direction="270" Opacity="0.38"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#38EFB0" Offset="0.0"/>
                                            <GradientStop Color="#14C98E" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#34D399" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.55"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#0DAF78" Offset="0.0"/>
                                            <GradientStop Color="#079464" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#0E9F6E" BlurRadius="3" ShadowDepth="0.5" Direction="270" Opacity="0.25"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#A7F3D0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                                <Setter TargetName="border" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Action Button -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeSecondaryBtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryBtnFg}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSecondaryBtnBorder}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeSecondaryBtnHoverBg}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeCardSubBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger / Red Button (Dynamic Theme Aware) -->
        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeDangerBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeDangerBtnBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeDangerBtnFg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeDangerBtnHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======================================================= -->
        <!-- SUB-BAR ACTION BUTTON STYLES (Đồng bộ chiều cao, bo góc, font) -->
        <!-- ======================================================= -->
        <!-- SubBar Secondary Button (Restore, Refresh) -->
        <Style x:Key="SubBarSecondaryBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeSecondaryBtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryBtnFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSecondaryBtnBorder}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeSecondaryBtnHoverBg}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeCardSubBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SubBar Danger Button (Close Chrome / IDE, Cancel OAuth) -->
        <Style x:Key="SubBarDangerBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeDangerBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeDangerBtnBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeDangerBtnFg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeDangerBtnHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SubBar Green / Success Button (OAuth Login - Đồng bộ Flat / Tinted Pill) -->
        <Style x:Key="SubBarGreenBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeSuccessBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSuccessBtnBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeSuccessBtnFg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeSuccessBtnHoverBg}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#34D399"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Toggle Card CheckBox (Compact) -->
        <Style x:Key="OptionCardCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="cardBorder" Background="{DynamicResource ThemeOptionCardBg}" BorderBrush="{DynamicResource ThemeOptionCardBorder}" BorderThickness="1" 
                                CornerRadius="8" Padding="7,4" Margin="2,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Custom Switch Pill -->
                                <Border x:Name="switchTrack" Grid.Column="0" Width="26" Height="15" CornerRadius="7.5" 
                                        Background="{DynamicResource ThemeProgressBarTrack}" BorderBrush="{DynamicResource ThemeInputBorder}" BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse x:Name="switchThumb" Width="9" Height="9" Fill="#64748B" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                                </Border>

                                <!-- Content text -->
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="cardBorder" Property="Background" Value="{DynamicResource ThemeOptionCardCheckedBg}"/>
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="{DynamicResource ThemeOptionCardCheckedBorder}"/>
                                <Setter TargetName="switchTrack" Property="Background" Value="#0284C7"/>
                                <Setter TargetName="switchTrack" Property="BorderBrush" Value="#0369A1"/>
                                <Setter TargetName="switchThumb" Property="Fill" Value="#FFFFFF"/>
                                <Setter TargetName="switchThumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="switchThumb" Property="Margin" Value="0,0,2,0"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeOptionCardCheckedFg}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navigation Tab Active Style (Modern Segmented Pill) -->
        <Style x:Key="NavTabActiveBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeNavActiveBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeNavActiveFg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="134"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeNavActiveBorder}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navigation Tab Inactive Style -->
        <Style x:Key="NavTabInactiveBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeNavInactiveFg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="134"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource ThemeNavInactiveHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeNavInactiveHoverFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Antigravity Account Item Template -->
        <DataTemplate x:Key="AntigravityAccountTemplate">
            <Border CornerRadius="10" Margin="0,0,0,5" Padding="12,7">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource ThemeCardBg}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeCardDefaultBg}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardDefaultBorder}"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                    <Condition Binding="{Binding IsActive}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource ThemeCardHoverBg}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardHoverBorder}"/>
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsKeyboardSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="Background" Value="{DynamicResource ThemeCardHoverBg}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- 0: Avatar -->
                        <ColumnDefinition Width="*"/>    <!-- 1: Name, Email, Status Badges -->
                        <ColumnDefinition Width="Auto"/> <!-- 2: Visual Mini Quota Progress Bars -->
                        <ColumnDefinition Width="Auto"/> <!-- 3: Actions -->
                    </Grid.ColumnDefinitions>

                    <!-- Avatar / Monogram with Google Gemini Pro Ring -->
                    <Grid Grid.Column="0" Width="44" Height="44" Margin="0,0,12,0" VerticalAlignment="Center">
                        <!-- Gemini Pro Gradient Ring (Visible only for PRO / ULTRA / ENTERPRISE) -->
                        <Border Width="44" Height="44" CornerRadius="22" BorderThickness="2.5" 
                                BorderBrush="{StaticResource GeminiProRingBrush}" 
                                Effect="{StaticResource GeminiProRingGlow}"
                                Visibility="{Binding ProRingVisibility}" 
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <!-- Normal subtle border (Visible only for FREE / non-Pro) -->
                        <Border Width="40" Height="40" CornerRadius="20" BorderThickness="1" 
                                BorderBrush="{DynamicResource ThemeAccountAvatarBorder}" 
                                Visibility="{Binding NormalRingVisibility}" 
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <!-- Inner Avatar Surface (Padded inside the Pro ring) -->
                        <Grid Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Monogram Fallback (uses dark teal #00382B for Pro!) -->
                            <Border CornerRadius="18" Background="{Binding AvatarBackgroundBrush}">
                                <TextBlock Text="{Binding InitialLetter}" Foreground="#FFFFFF" FontWeight="Bold" 
                                           FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- Google Avatar Image (overlays monogram when available) -->
                            <Border CornerRadius="18" Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVis}}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding AvatarSource}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Account Details -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding NameMasked}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimary}" 
                                       VerticalAlignment="Center" MaxWidth="170" TextTrimming="CharacterEllipsis" ToolTip="Nhấp chuột để ẩn/hiện tên tài khoản này"
                                       Cursor="Hand" MouseDown="TxtAccountName_MouseDown"/>
                            
                            <!-- GOOGLE Badge -->
                            <Border Margin="6,0,4,0" CornerRadius="4" BorderBrush="{DynamicResource ThemeCardSubBorder}" Background="{DynamicResource ThemeCardSubBg}" BorderThickness="1" Padding="4,1" VerticalAlignment="Center">
                                <TextBlock Text="GOOGLE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}"/>
                            </Border>

                            <!-- Plan Badge -->
                            <Border CornerRadius="5" Background="{Binding PlanBadgeBackground}" BorderBrush="{Binding PlanBadgeBorderBrush}" BorderThickness="1" Padding="6.5,1.5" Margin="0,0,4,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlanBadgeText}" Value="PRO">
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#EC4899" BlurRadius="10" ShadowDepth="0" Opacity="0.7"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding PlanBadgeDisplay}" FontSize="9.5" Foreground="{Binding PlanBadgeForeground}" FontWeight="Black" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Active Status Badge -->
                            <Border Margin="4,0,0,0" CornerRadius="4" Padding="6,1.5" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource ThemeActiveStatusBadgeBg}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeActiveStatusBadgeBorder}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                             <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ThemeStatusRunningBg}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeStatusRunningBorder}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding ActiveBadgeText}" FontSize="10" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource ThemeActiveStatusBadgeFg}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource ThemeStatusRunningFg}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <!-- In-progress refresh badge -->
                            <Border Margin="4,0,0,0" CornerRadius="4" Background="{DynamicResource ThemeCardSubBg}" BorderBrush="{DynamicResource ThemeInputBorder}" BorderThickness="1" 
                                    Padding="5,1.5" VerticalAlignment="Center" Visibility="{Binding RefreshingBadgeVisibility}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⏳ " FontSize="9" VerticalAlignment="Center"/>
                                    <TextBlock Text="Đang đo..." FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource ThemeNavActiveFg}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <WrapPanel Orientation="Horizontal" Margin="0,3,0,0" VerticalAlignment="Center">
                            <!-- Email Badge (Click to toggle privacy, right-click to copy) -->
                            <Border Background="{DynamicResource ThemeCardSubBg}" CornerRadius="5" Padding="6,2" Margin="0,0,6,0"
                                    BorderBrush="{DynamicResource ThemeCardSubBorder}" BorderThickness="1" VerticalAlignment="Center"
                                    Cursor="Hand" MouseDown="BtnCopyEmailBadge_MouseDown" MouseRightButtonUp="BtnCopyEmailBadge_MouseRightButtonUp"
                                    ToolTip="Nhấp chuột trái: Ẩn/Hiện email | Nhấp chuột phải: Sao chép email">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📧 " FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding EmailMasked}" FontSize="11" Foreground="{DynamicResource ThemeEmailFg}" FontWeight="Medium"
                                               MaxWidth="175" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- Token Warning Badge (Only visible when OAuth login is required; avoids duplicating 'Sẵn sàng') -->
                            <Border Background="{DynamicResource ThemeCardSubBg}" CornerRadius="5" Padding="6,2" Margin="0,0,6,0"
                                    BorderBrush="{DynamicResource ThemeCardSubBorder}" BorderThickness="1" VerticalAlignment="Center"
                                    Visibility="{Binding TokenWarningVisibility}">
                                <TextBlock Text="{Binding TokenStatusText}" FontSize="10" 
                                           Foreground="{Binding TokenStatusColor}"/>
                            </Border>

                            <!-- Token Expiry & Auto-Refresh Badge -->
                            <Border Background="{DynamicResource ThemeCardSubBg}" CornerRadius="5" Padding="6,2" Margin="0,0,6,0"
                                    BorderBrush="{DynamicResource ThemeCardSubBorder}" BorderThickness="1" VerticalAlignment="Center"
                                    ToolTip="Trạng thái Access Token. Có Refresh Token thì hệ thống và IDE tự động cấp mới mà không cần đăng nhập lại.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⏳ " FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding FormattedExpiry}" FontSize="10" Foreground="{DynamicResource ThemeGeminiDisplayFg}"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <!-- 2. Visual Mini Quota Progress Bars for this Account -->
                    <Border Grid.Column="2" Background="{DynamicResource ThemeCardSubBg}" BorderBrush="{DynamicResource ThemeCardSubBorder}" BorderThickness="1" 
                            CornerRadius="8" Padding="10,5" Margin="8,0,10,0" VerticalAlignment="Center"
                            ToolTip="{Binding ModelQuotaDetailedTooltip}">
                        <Grid Width="175">
                            <!-- Normal Display: Visual Mini Quota Progress Bars -->
                            <StackPanel Visibility="{Binding QuotaContentVisibility}">
                                <!-- Gemini Mini Bar (Scoped: 5h / Tuần / Cả hai) -->
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding GeminiScopedLabel}" FontSize="10" Foreground="{DynamicResource ThemeGeminiLabelFg}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,4,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding GeminiScopedDisplay}" FontSize="9.5" Foreground="{DynamicResource ThemeGeminiDisplayFg}" FontWeight="Bold"/>
                                </Grid>
                                <Border Width="175" Height="5" CornerRadius="2.5" Background="{DynamicResource ThemeProgressBarTrack}" HorizontalAlignment="Left" Margin="0,0,0,4">
                                    <Border Width="{Binding GeminiScopedBarWidth}" Height="5" CornerRadius="2.5" Background="{Binding GeminiScopedBarBrush}" HorizontalAlignment="Left"/>
                                </Border>

                                <!-- Claude / GPT Mini Bar (Scoped: 5h / Tuần / Cả hai) -->
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ClaudeScopedLabel}" FontSize="10" Foreground="{DynamicResource ThemeClaudeLabelFg}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,4,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ClaudeScopedDisplay}" FontSize="9.5" Foreground="{Binding ClaudeMiniBarTextColor}" FontWeight="Bold"/>
                                </Grid>
                                <Border Width="175" Height="5" CornerRadius="2.5" Background="{DynamicResource ThemeProgressBarTrack}" HorizontalAlignment="Left">
                                    <Border Width="{Binding ClaudeScopedBarWidth}" Height="5" CornerRadius="2.5" Background="{Binding ClaudeScopedBarBrush}" HorizontalAlignment="Left"/>
                                </Border>
                            </StackPanel>

                            <!-- Refreshing Live Indicator -->
                            <Border Visibility="{Binding RefreshingBadgeVisibility}" Background="{DynamicResource ThemeActiveHeroBadgeBg}" BorderBrush="{DynamicResource ThemeActiveHeroBadgeBorder}" BorderThickness="1" CornerRadius="6" Padding="6,6">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="⏳ " FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding MeasuringQuotaText}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeActiveHeroBadgeFg}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Actions (Supports Left/Right arrow cycling and Enter/Space trigger) -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Switch Button (Action 0) -->
                        <Button Tag="{Binding}" Click="BtnSwitchAntigravityAccount_Click" Margin="0,0,6,0" Padding="10,5"
                                Content="{Binding SwitchButtonText}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryGreenBtn}">
                                    <Setter Property="IsEnabled" Value="{Binding CanSwitchAccount}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Background" Value="{DynamicResource ThemeActiveStatusBadgeBg}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource ThemeGeminiDisplayFg}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource ThemeActiveStatusBadgeBorder}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsTargetOfSwitch}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="BorderBrush" Value="#F59E0B"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSwitchFocused}" Value="True">
                                            <Setter Property="BorderBrush" Value="#F59E0B"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Refresh Single Account Quota Button (Action 1) -->
                        <Button Tag="{Binding}" Click="BtnRefreshSingleAccountQuota_Click" Margin="0,0,5,0" Padding="7,5" ToolTip="{Binding RefreshTooltipText}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRefreshFocused}" Value="True">
                                            <Setter Property="BorderBrush" Value="#38BDF8"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="Background" Value="{DynamicResource ThemeCardHoverBg}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="🔄"/>
                        </Button>

                        <!-- Quota Detail Button (Action 2) -->
                        <Button Tag="{Binding}" Click="BtnViewAccountQuota_Click" Margin="0,0,5,0" Padding="8,5" ToolTip="Xem chi tiết 20 Model (Nhấn Enter để mở)">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsModelFocused}" Value="True">
                                            <Setter Property="BorderBrush" Value="#38BDF8"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="Background" Value="{DynamicResource ThemeCardHoverBg}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="📊 20 Model"/>
                        </Button>

                        <!-- Delete Account Button (Action 3) -->
                        <Button Tag="{Binding}" Click="BtnDeleteAntigravityAccount_Click" Margin="0" Padding="7,5" ToolTip="Xóa khỏi danh sách (Nhấn Enter để xóa)">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DangerBtn}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDeleteFocused}" Value="True">
                                            <Setter Property="BorderBrush" Value="#EF4444"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="Background" Value="{DynamicResource ThemeDangerBtnHoverBg}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="🗑️"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Profile Item Card Template (With Google Accounts info) -->
        <DataTemplate x:Key="ProfileItemTemplate">
            <Border x:Name="CardBorder" CornerRadius="10" Margin="0,0,0,6" Padding="12,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource ThemeCardBg}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeCardDefaultBg}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardDefaultBorder}"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </DataTrigger>
                            <!-- Mouse Over Effect (only if not default) -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                    <Condition Binding="{Binding IsDefault}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource ThemeCardHoverBg}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardHoverBorder}"/>
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsKeyboardSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="Background" Value="{DynamicResource ThemeCardHoverBg}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Avatar with subtle ring -->
                    <Grid Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center">
                        <!-- Monogram Fallback -->
                        <Border CornerRadius="20" Background="{Binding InitialBrush}">
                            <TextBlock Text="{Binding InitialLetter}" Foreground="#FFFFFF" FontWeight="Bold" 
                                       FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Actual Image if exists (Direct GPU-rendered Ellipse ImageBrush) -->
                        <Ellipse Width="40" Height="40">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AvatarSource}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding AvatarSource}" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <!-- Outer Subtle Ring -->
                        <Ellipse Stroke="#25FFFFFF" StrokeThickness="1.5"/>
                    </Grid>

                    <!-- Profile Text Information -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                        <!-- Line 1: Name, Status Badge, and Running & RAM Badge -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding NameMasked}" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource ThemeTextPrimary}" 
                                       VerticalAlignment="Center" MaxWidth="170" TextTrimming="CharacterEllipsis"
                                       Cursor="Hand" MouseDown="TxtProfileName_MouseDown"
                                       ToolTip="{Binding ProfileNameTooltip}"/>
                            
                            <!-- Badges -->
                            <Border Margin="8,0,0,0" Padding="7,2" CornerRadius="8" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource ThemeCardSubBg}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardSubBorder}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ThemeStatusRunningBg}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeStatusRunningBorder}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="5.5" Height="5.5" Margin="0,0,4,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#64748B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource ThemeStatusRunningDot}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock FontSize="10" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Id}"/>
                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                        <Setter Property="Text" Value="{Binding DefaultBadgeText}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeStatusRunningFg}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Running & RAM Badge (Placed on Line 1) -->
                            <Border CornerRadius="5" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Background="{DynamicResource ThemeStatusRunningBg}" BorderBrush="{DynamicResource ThemeStatusRunningBorder}" BorderThickness="1.5"
                                    ToolTip="{Binding RunningBadgeTooltip}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource ThemeStatusRunningDot}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding RunningBadgeText}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ThemeStatusRunningFg}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Line 2: Email, Google Accounts badge, and Folder ID (Wrappable) -->
                        <WrapPanel Orientation="Horizontal" Margin="0,2,0,0" VerticalAlignment="Center">
                            <!-- Primary Email -->
                            <!-- Primary Email -->
                            <Border Background="{DynamicResource ThemeCardSubBg}" CornerRadius="5" Padding="6,2" Margin="0,0,8,0"
                                    BorderBrush="{DynamicResource ThemeCardSubBorder}" BorderThickness="1" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UserName}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📧 " FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding UserNameMasked}" FontSize="11" Foreground="{DynamicResource ThemeEmailFg}" FontWeight="Medium" VerticalAlignment="Center"
                                               MaxWidth="180" TextTrimming="CharacterEllipsis" Cursor="Hand"
                                               MouseDown="TxtProfileEmail_MouseDown" MouseRightButtonUp="TxtProfileEmail_MouseRightButtonUp"
                                               ToolTip="{Binding ProfileEmailTooltip}"/>
                                </StackPanel>
                            </Border>

                            <!-- Unsigned / Local Profile indicator (Shown when UserName is empty) -->
                            <Border Background="{DynamicResource ThemeCardSubBg}" CornerRadius="5" Padding="6,2" Margin="0,0,8,0"
                                    BorderBrush="{DynamicResource ThemeCardSubBorder}" BorderThickness="1" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UserName}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="👤 " FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding UnsignedText}" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}" FontWeight="Normal" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Google Accounts Count Badge -->
                            <Border Tag="{Binding}" CornerRadius="5" Padding="7,2" Margin="0,0,8,0"
                                    Cursor="Hand" MouseDown="BtnViewAccounts_Click" ToolTip="{Binding AccountsTooltipText}"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource ThemeAccountsBadgeBg}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccountsBadgeBorder}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasGoogleAccount}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="#38BDF8"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="👥 " FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding AccountsBadgeText}" FontSize="10" FontWeight="SemiBold" 
                                               Foreground="{DynamicResource ThemeAccountsBadgeFg}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Folder ID (Only shown when IsDefault is True, as Id is already on Line 1 for others) -->
                            <Border Background="{DynamicResource ThemeCardSubBg}" CornerRadius="5" Padding="6,2" BorderBrush="{DynamicResource ThemeCardSubBorder}" BorderThickness="1" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FolderPrefixText}" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,3,0"/>
                                    <TextBlock Text="{Binding Id}" FontSize="10.5" Foreground="{DynamicResource ThemeTextSecondary}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Set Default Button -->
                        <Button Tag="{Binding}" Click="BtnSetDefault_Click" Margin="0,0,6,0" Padding="10,5"
                                Content="{Binding SetDefaultButtonContent}" ToolTip="{Binding SetDefaultTooltip}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryGreenBtn}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Background" Value="{DynamicResource ThemeStatusRunningBg}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource ThemeStatusRunningFg}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource ThemeStatusRunningBorder}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSetDefaultFocused}" Value="True">
                                            <Setter Property="BorderBrush" Value="#F59E0B"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Launch Profile Button -->
                        <Button Tag="{Binding}" Click="BtnLaunchProfile_Click" 
                                Content="{Binding LaunchButtonContent}" Margin="0,0,5,0" Padding="8,5" ToolTip="{Binding LaunchButtonTooltip}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOpenFocused}" Value="True">
                                            <Setter Property="BorderBrush" Value="#38BDF8"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="Background" Value="{DynamicResource ThemeCardHoverBg}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Desktop Shortcut Button -->
                        <Button Tag="{Binding}" Click="BtnCreateShortcut_Click" 
                                Content="📌 Shortcut" Padding="8,5" ToolTip="{Binding ShortcutButtonTooltip}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsShortcutFocused}" Value="True">
                                            <Setter Property="BorderBrush" Value="#38BDF8"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="Background" Value="{DynamicResource ThemeCardHoverBg}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Modern Custom ComboBox Style for Modal -->
        <Style x:Key="ModernModalComboBox" TargetType="ComboBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeInputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Toggle Button with Border and Chevron Arrow -->
                            <ToggleButton x:Name="ToggleButton" 
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="templateRoot" 
                                                Background="{DynamicResource ThemeInputBg}" 
                                                BorderBrush="{DynamicResource ThemeInputBorder}" 
                                                BorderThickness="1.5" 
                                                CornerRadius="8" 
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Modern Down Chevron -->
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource ThemeTextSecondary}" 
                                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="templateRoot" Property="BorderBrush" Value="#10B981"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="templateRoot" Property="BorderBrush" Value="#10B981"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Selected Item Content Display -->
                            <ContentPresenter Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left" 
                                              Margin="12,0,30,0"/>

                            <!-- Dropdown Popup -->
                            <Popup Name="Popup" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown" 
                                      SnapsToDevicePixels="True" 
                                      MinWidth="{TemplateBinding ActualWidth}" 
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" 
                                            Background="{DynamicResource ThemeContextMenuBg}" 
                                            BorderBrush="{DynamicResource ThemeContextMenuBorder}" 
                                            BorderThickness="1" 
                                            CornerRadius="8" 
                                            Margin="0,4,0,4" 
                                            Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.4" Color="#000000"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBoxItem Style -->
        <Style x:Key="ModernModalComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="Transparent" CornerRadius="6" 
                                Padding="{TemplateBinding Padding}" Margin="1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource ThemeMenuItemHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource ThemeMenuItemHover}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#10B981"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick Preset Interval Pill Button -->
        <Style x:Key="PresetChipBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeCardSubBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardSubBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,4.5"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chipBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="13" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chipBorder" Property="Background" Value="{DynamicResource ThemeCardHoverBg}"/>
                                <Setter TargetName="chipBorder" Property="BorderBrush" Value="#10B981"/>
                                <Setter Property="Foreground" Value="#10B981"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="chipBorder" Property="Background" Value="#10B981"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modal Top-Right Close Button -->
        <Style x:Key="ModernModalCloseBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource ThemeCardHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource ThemeSecondaryBtnHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Caption Button Base Style -->
        <Style x:Key="WindowCaptionBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="capBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="capBorder" Property="Background" Value="{DynamicResource ThemeSecondaryBtnHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="capBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Close Button Style (Modern Red Hover) -->
        <Style x:Key="WindowCloseBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="1,0,0,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="closeBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="closeBorder" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="closeBorder" Property="Background" Value="#C4101E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainRootBorder"
            Background="{DynamicResource ThemeWindowBg}"
            BorderBrush="{DynamicResource ThemeHeaderBorder}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <!-- Background subtle glow layer -->
            <Border Background="{DynamicResource ThemeWindowGlowBrush}" CornerRadius="10"/>

            <!-- Main Window Layout Rows -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0: Header Bar -->
                    <RowDefinition Height="*"/>    <!-- 1: Active Tab Container -->
                </Grid.RowDefinitions>

                <!-- 0. Header Bar (Integrated Custom Window Title Bar & Navigation) -->
                <Border x:Name="MainHeaderBorder" Grid.Row="0" Background="{DynamicResource ThemeHeaderBg}" BorderBrush="{DynamicResource ThemeHeaderBorder}" BorderThickness="0,0,0,1" CornerRadius="9,9,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Row 0: Window Title Bar (Brand, Tabs, Theme/Lang & Window Controls) -->
                            <RowDefinition Height="40"/>
                            <!-- Row 1: Quick Actions & Process Status Bar (Dòng dưới) -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ROW 0: TITLE BAR (Caption Area) -->
                        <Grid Grid.Row="0" Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <!-- Left: Brand Identity & Navigation Tab Switcher -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- Center: Flexible Spacer (Window Drag Area & Double-Click to Maximize) -->
                                <ColumnDefinition Width="*"/>
                                <!-- Right: Theme, Lang & Window Caption Buttons -->
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Brand Identity + Compact Navigation Tabs -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- App Title & Icon -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource ThemeCardSubBg}" Margin="0,0,7,0" 
                                            BorderBrush="{DynamicResource ThemeCardSubBorder}" BorderThickness="1">
                                        <TextBlock x:Name="TxtHeaderIcon" Text="🚀" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="TxtHeaderTitle" Text="Antigravity Hub" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                            <Border Background="{DynamicResource ThemeCardSubBg}" BorderBrush="{DynamicResource ThemeCardSubBorder}" BorderThickness="1" CornerRadius="4" Padding="3,0" Margin="4,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="v2.5" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeNavActiveFg}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtHeaderSubtitle" Text="Chrome &amp; Antigravity" FontSize="9" Foreground="{DynamicResource ThemeTextSecondary}" Visibility="Collapsed"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Clean Vertical Divider -->
                                <Rectangle Width="1" Height="18" Fill="{DynamicResource ThemeCardSubBorder}" Margin="0,0,10,0" VerticalAlignment="Center"/>

                                <!-- Navigation Tabs (Modern Segmented Control) -->
                                <Border WindowChrome.IsHitTestVisibleInChrome="True" Background="{DynamicResource ThemeNavBg}" BorderBrush="{DynamicResource ThemeNavBorder}" BorderThickness="1" CornerRadius="7" Padding="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnNavChrome" Width="96" Height="27" Click="BtnNavChrome_Click" Style="{StaticResource NavTabActiveBtn}" Content="🌐 Chrome" Margin="0,0,2,0"/>
                                        <Button x:Name="BtnNavAntigravity" Width="110" Height="27" Click="BtnNavAntigravity_Click" Style="{StaticResource NavTabInactiveBtn}" Content="🚀 Antigravity"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Right: Theme, Language & Window Caption Controls -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                                <!-- Light/Dark Mode Toggle Button (Compact Icon Button) -->
                                <Button x:Name="BtnThemeToggle" Style="{StaticResource SecondaryBtn}" Height="28" Width="30" Padding="0" Margin="2,0,0,0" Click="BtnThemeToggle_Click"
                                        ToolTip="Chuyển đổi giao diện Sáng / Tối (Dark / Light Mode)">
                                    <Grid Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path x:Name="IconSun" Data="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zm0 8c-1.65 0-3-1.35-3-3s1.35-3 3-3 3 1.35 3 3-1.35 3-3 3zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58a.996.996 0 00-1.41 0 .996.996 0 000 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37a.996.996 0 00-1.41 0 .996.996 0 000 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41l-1.06-1.06zm-12.37 0l-1.06 1.06a.996.996 0 000 1.41c.39.39 1.03.39 1.41 0l1.06-1.06c.39-.39.39-1.03 0-1.41a.996.996 0 00-1.41 0zm12.37-12.37l-1.06 1.06a.996.996 0 000 1.41c.39.39 1.03.39 1.41 0l1.06-1.06a.996.996 0 000-1.41c-.39-.39-1.03-.39-1.41 0z" 
                                              Fill="#F59E0B" Stretch="Uniform"/>
                                        <Path x:Name="IconMoon" Data="M12.3 2a10 10 0 0 0-.19 14 10 10 0 0 0 11.89 0A10 10 0 1 1 12.3 2z" 
                                              Fill="#38BDF8" Stretch="Uniform" Visibility="Collapsed"/>
                                        <TextBlock x:Name="TxtThemeText" Visibility="Collapsed"/>
                                    </Grid>
                                </Button>

                                <!-- Language Switcher Button (VI / EN) -->
                                <Button x:Name="BtnLanguageToggle" Style="{StaticResource SecondaryBtn}" Height="28" Padding="6,0" Margin="4,0,0,0" Click="BtnLanguageToggle_Click"
                                        ToolTip="Chuyển đổi ngôn ngữ / Switch Language (Tiếng Việt / English)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtLanguageFlag" Text="🇻🇳" FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtLanguageText" Text="VI" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Information / About Button -->
                                <Button x:Name="BtnAbout" Style="{StaticResource SecondaryBtn}" Height="28" Width="30" Padding="0" Margin="4,0,0,0" Click="BtnAbout_Click"
                                        ToolTip="Thông tin tác giả &amp; Dự án (About &amp; Author)">
                                    <Grid Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                        <Path Data="M 8,1 C 4.134,1 1,4.134 1,8 1,11.866 4.134,15 8,15 11.866,15 15,11.866 15,8 15,4.134 11.866,1 8,1 Z M 8,2.6 C 10.982,2.6 13.4,5.018 13.4,8 13.4,10.982 10.982,13.4 8,13.4 5.018,13.4 2.6,10.982 2.6,8 2.6,5.018 5.018,2.6 8,2.6 Z M 8,4.5 C 7.448,4.5 7,4.948 7,5.5 7,6.052 7.448,6.5 8,6.5 8.552,6.5 9,6.052 9,5.5 9,4.948 8.552,4.5 8,4.5 Z M 7.2,7.5 H 8.8 V 11.5 H 7.2 Z" 
                                              Fill="{DynamicResource ThemeNavActiveFg}" Stretch="Uniform" SnapsToDevicePixels="True"/>
                                    </Grid>
                                </Button>

                                <!-- Clean Vertical Separator -->
                                <Rectangle Width="1" Height="18" Fill="{DynamicResource ThemeHeaderBorder}" Margin="8,0,6,0" VerticalAlignment="Center"/>

                                <!-- Window Caption Controls (Minimize, Maximize / Restore, Close) -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Minimize Button -->
                                    <Button x:Name="BtnWinMinimize" Style="{StaticResource WindowCaptionBtn}" Click="BtnWinMinimize_Click" ToolTip="Thu nhỏ">
                                        <Path Data="M 0,5 L 10,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Button}}" StrokeThickness="1.2" Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Button>

                                    <!-- Maximize / Restore Button -->
                                    <Button x:Name="BtnWinMaximize" Style="{StaticResource WindowCaptionBtn}" Click="BtnWinMaximize_Click" ToolTip="Phóng to">
                                        <Grid Width="10" Height="10">
                                            <Path x:Name="PathWinMaximize" Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Button}}" StrokeThickness="1.2" Width="10" Height="10"/>
                                            <Path x:Name="PathWinRestore" Data="M 2.5,0.5 L 9.5,0.5 L 9.5,7.5 M 0.5,2.5 L 7.5,2.5 L 7.5,9.5 L 0.5,9.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Button}}" StrokeThickness="1.2" Width="10" Height="10" Visibility="Collapsed"/>
                                        </Grid>
                                    </Button>

                                    <!-- Close Button -->
                                    <Button x:Name="BtnWinClose" Style="{StaticResource WindowCloseBtn}" Click="BtnWinClose_Click" ToolTip="Đóng">
                                        <Path Data="M 0.5,0.5 L 9.5,9.5 M 9.5,0.5 L 0.5,9.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Button}}" StrokeThickness="1.2" Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- ROW 1: STATUS DASHBOARD & QUICK ACTIONS SUB-BAR -->
                        <Border Grid.Row="1" Background="{DynamicResource ThemeCardSubBg}" BorderBrush="{DynamicResource ThemeHeaderBorder}" BorderThickness="0,1,0,0" Padding="12,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- Left: Status & System Monitoring -->
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- Center: Flexible Spacer -->
                                    <ColumnDefinition Width="*"/>
                                    <!-- Right: Action Buttons (Chrome & Antigravity) -->
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Subtle Context & Live Status Monitors -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtSubHeaderHint" Text="⚡ Trạng thái Chrome &amp; Thao tác nhanh" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                    <!-- Chrome Status Indicator (Visible in Chrome View) -->
                                    <Border x:Name="BorderChromeStatus" CornerRadius="6" Background="{DynamicResource ThemeStatusIndicatorBg}" Height="28" Padding="8,0" Margin="0,0,6,0" 
                                            BorderBrush="{DynamicResource ThemeStatusIndicatorBorder}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="StatusDot" Width="6.5" Height="6.5" Fill="{DynamicResource ThemeStatusRunningDot}" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="TxtChromeStatus" Text="Chrome đã đóng" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeStatusIndicatorFg}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Antigravity Status Indicator (Visible in Antigravity View) -->
                                    <Border x:Name="BorderAntigravityStatus" CornerRadius="6" Background="{DynamicResource ThemeStatusIndicatorBg}" Height="28" Padding="8,0" Margin="0,0,6,0" 
                                            BorderBrush="{DynamicResource ThemeStatusIndicatorBorder}" BorderThickness="1" Visibility="Collapsed"
                                            ToolTip="Trạng thái tiến trình và bộ nhớ Antigravity IDE">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="AntigravityStatusDot" Width="6.5" Height="6.5" Fill="{DynamicResource ThemeStatusRunningDot}" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="TxtAntigravityStatus" Text="IDE đang mở" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeStatusIndicatorFg}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Right: Actions for Chrome / Antigravity -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Status & Quick Action Buttons (Chrome View) -->
                                    <StackPanel x:Name="PanelChromeActions" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Close Chrome Button (Visible when Chrome running) -->
                                        <Button x:Name="BtnCloseChrome" Style="{StaticResource SubBarDangerBtn}" Height="28" Padding="9,0" Content="🛑 Tắt" 
                                                Margin="0,0,5,0" Click="BtnCloseChrome_Click" Visibility="Collapsed"
                                                ToolTip="Đóng tất cả tiến trình Chrome để cập nhật triệt để"/>

                                        <!-- Refresh Button -->
                                        <Button x:Name="BtnRefreshChrome" Style="{StaticResource SubBarSecondaryBtn}" Height="28" Padding="9,0" Content="🔄 Làm mới" Click="BtnRefresh_Click"
                                                Margin="0,0,0,0" ToolTip="Tải lại danh sách profiles và trạng thái Chrome (F5)"/>
                                    </StackPanel>

                                    <!-- Status & Quick Action Buttons (Antigravity View) -->
                                    <StackPanel x:Name="PanelAntigravityActions" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                        <!-- Close Antigravity IDE Button (Visible when IDE running) -->
                                        <Button x:Name="BtnCloseAntigravity" Style="{StaticResource SubBarDangerBtn}" Height="28" Padding="9,0" Content="🛑 Tắt" 
                                                Margin="0,0,5,0" Click="BtnCloseAntigravity_Click" Visibility="Collapsed"
                                                ToolTip="Đóng tất cả tiến trình Antigravity IDE &amp; Language Server để giải phóng RAM"/>

                                        <!-- OAuth Login via Browser Button -->
                                        <Button x:Name="BtnOAuthLogin" Style="{StaticResource SubBarGreenBtn}" Height="28" Padding="9,0" Content="🔑 Đăng nhập" 
                                                Margin="0,0,5,0" Click="BtnOAuthLoginAntigravity_Click"
                                                ToolTip="Đăng nhập tài khoản Antigravity qua trình duyệt (OAuth). Chỉ cần đăng nhập 1 lần, lần sau ấn Switch là xong!"/>

                                        <!-- Cancel OAuth Login Button -->
                                        <Button x:Name="BtnCancelOAuthLogin" Style="{StaticResource SubBarDangerBtn}" Height="28" Padding="8,0" Content="❌ Hủy" 
                                                Margin="0,0,5,0" Click="BtnCancelOAuthLogin_Click" Visibility="Collapsed"
                                                ToolTip="Hủy quá trình đăng nhập đang chờ"/>

                                        <!-- Restore Chat History Button (Antigravity 2.0 Restore Fix) -->
                                        <Button x:Name="BtnRestoreChatHistory" Style="{StaticResource SubBarSecondaryBtn}" Height="28" Padding="9,0" Content="💬 Khôi phục"
                                                Margin="0,0,5,0" Click="BtnRestoreChatHistory_Click"
                                                ToolTip="Khôi phục và ánh xạ lại toàn bộ lịch sử chat bị mất về các project sidebar (Fix lỗi Antigravity 2.0)"/>

                                        <!-- Refresh Button -->
                                        <Button x:Name="BtnRefreshAntigravity" Style="{StaticResource SubBarSecondaryBtn}" Height="28" Padding="9,0" Content="🔄 Làm mới" Click="BtnRefreshAntigravity_Click"
                                                Margin="0,0,0,0" ToolTip="Tải lại danh sách tài khoản Antigravity (F5)"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

            <!-- ======================================================= -->
            <!-- TAB 1: CHROME PROFILES VIEW -->
            <!-- ======================================================= -->
            <Grid x:Name="ViewChrome" Grid.Row="1" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0: Hero Default Profile Banner -->
                    <RowDefinition Height="*"/>    <!-- 1: Search & Profiles List -->
                    <RowDefinition Height="Auto"/> <!-- 2: Bottom Settings & Options -->
                </Grid.RowDefinitions>

            <!-- 1. Hero Current Default Profile Banner (Matching Antigravity Hero Styling) -->
            <Border Grid.Row="0" Margin="16,8,16,6" CornerRadius="12" Padding="16,13" BorderThickness="1.5"
                    Background="{DynamicResource ThemeAntigravityHeroBg}" BorderBrush="{DynamicResource ThemeHeroBorderBrush}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Hero Avatar with double glowing ring -->
                    <Grid Grid.Column="0" Width="46" Height="46" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Border CornerRadius="23" Background="#0284C7">
                            <TextBlock x:Name="TxtHeroInitial" Text="?" Foreground="#FFFFFF" FontWeight="Bold" 
                                       FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border CornerRadius="23">
                            <Border.OpacityMask>
                                <VisualBrush>
                                    <VisualBrush.Visual>
                                        <Ellipse Width="46" Height="46" Fill="Black"/>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Border.OpacityMask>
                            <Image x:Name="ImgHeroAvatar" Stretch="UniformToFill"/>
                        </Border>
                        <Ellipse Stroke="#50FFFFFF" StrokeThickness="1.5"/>
                    </Grid>

                    <!-- Hero Details (Generously spaced rows) -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                        <!-- Line 1: Subtitle badge + Running Status & RAM Badge -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                            <Border Background="{DynamicResource ThemeActiveHeroBadgeBg}" BorderBrush="{DynamicResource ThemeActiveHeroBadgeBorder}" BorderThickness="1" CornerRadius="5" 
                                    Padding="6,1.5" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtHeroDefaultBadge" Text="★ PROFILE MẶC ĐỊNH KHI MỞ CHROME" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource ThemeActiveHeroBadgeFg}"/>
                            </Border>
                            
                            <!-- Hero Running & RAM Badge (Clean on Line 1) -->
                            <Border x:Name="BorderHeroRunningBadge" Margin="2,0,0,0" Background="{DynamicResource ThemeStatusRunningBg}" BorderBrush="{DynamicResource ThemeStatusRunningBorder}" BorderThickness="1.5" 
                                    CornerRadius="6" Padding="8,2.5" VerticalAlignment="Center" Visibility="Collapsed"
                                    ToolTip="Profile mặc định này hiện đang hoạt động trong Chrome">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource ThemeStatusRunningDot}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtHeroRunningBadge" Text="Đang chạy" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ThemeStatusRunningFg}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Line 2: Name + Tag -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtHeroName" Text="Cá nhân 1" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeHeroTitleFg}" 
                                       VerticalAlignment="Center" MaxWidth="350" TextTrimming="CharacterEllipsis"
                                       Cursor="Hand" MouseDown="TxtHeroDefaultProfileName_MouseDown"
                                       ToolTip="Nhấp chuột để ẩn/hiện tên profile mặc định này"/>
                            <Border x:Name="BorderHeroTag" Margin="10,0,0,0" Background="{DynamicResource ThemeCardSubBg}" CornerRadius="6" Padding="7,2" 
                                    BorderBrush="{DynamicResource ThemeCardSubBorder}" BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtHeroTag" Text="[Default]" FontSize="11.5" Foreground="{DynamicResource ThemeEmailFg}" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        
                        <!-- Line 3: Email & Google Accounts Badge -->
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Hero Email -->
                            <Border x:Name="BorderHeroEmail" Background="{DynamicResource ThemeCardSubBg}" CornerRadius="6" Padding="8,3" Margin="0,0,10,0"
                                    BorderBrush="{DynamicResource ThemeCardSubBorder}" BorderThickness="1" VerticalAlignment="Center"
                                    Cursor="Hand" MouseDown="TxtHeroDefaultProfileEmail_MouseDown" MouseRightButtonUp="TxtHeroDefaultProfileEmail_MouseRightButtonUp"
                                    ToolTip="Nhấp chuột trái: Ẩn/Hiện email | Nhấp chuột phải: Sao chép email">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📧 " FontSize="10.5" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtHeroEmail" Text="phungtoan2006@gmail.com" 
                                               FontSize="11.5" Foreground="{DynamicResource ThemeEmailFg}" FontWeight="Medium" VerticalAlignment="Center"
                                               MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- Hero Accounts Badge -->
                            <Border x:Name="BorderHeroAccountsBadge" Background="{DynamicResource ThemeAccountsBadgeBg}" BorderBrush="{DynamicResource ThemeAccountsBadgeBorder}" BorderThickness="1" 
                                    CornerRadius="6" Padding="8,3" Cursor="Hand" MouseDown="BtnHeroViewAccounts_Click" 
                                    VerticalAlignment="Center" ToolTip="Nhấp để xem danh sách tài khoản Google đăng nhập trong Profile này">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="👥 " FontSize="10.5" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtHeroAccountsBadge" Text="10 tài khoản Google" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccountsBadgeFg}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Hero Quick Launch Button -->
                    <Button x:Name="BtnHeroLaunch" Grid.Column="2" Style="{StaticResource PrimaryGreenBtn}" Padding="15,9" 
                            Click="BtnHeroLaunch_Click" VerticalAlignment="Center" ToolTip="Mở Chrome với Profile mặc định này ngay lập tức">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtHeroLaunchText" Text="🚀 Mở Chrome Ngay" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 2. Search Box & Profile List Section -->
            <Grid Grid.Row="1" Margin="16,6,16,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title + Search Bar -->
                    <RowDefinition Height="*"/>    <!-- Profiles Scroll List -->
                </Grid.RowDefinitions>

                <!-- Search and Section Header (Unified with Antigravity Toolbar Style) -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Realtime Search Box -->
                    <Border Grid.Column="0" Background="{DynamicResource ThemeInputBg}" BorderBrush="{DynamicResource ThemeInputBorder}" BorderThickness="1" CornerRadius="8" Padding="10,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtSearchProfile" Grid.Column="1" Background="Transparent" BorderThickness="0" 
                                     Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11.5" VerticalAlignment="Center"
                                     CaretBrush="#38BDF8" TextChanged="TxtSearchProfile_TextChanged"/>
                            <TextBlock x:Name="TxtSearchProfilePlaceholder" Grid.Column="1" Text="Tìm theo tên profile, email Google..." FontSize="11.5" Foreground="{DynamicResource ThemeTextMuted}" 
                                       IsHitTestVisible="False" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=TxtSearchProfile, Path=Text}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button x:Name="BtnClearSearch" Grid.Column="2" Content="✕" Foreground="#94A3B8" Background="Transparent" 
                                    BorderThickness="0" Cursor="Hand" Click="BtnClearSearch_Click" Visibility="Collapsed"
                                    Focusable="False" IsTabStop="False"
                                    FontSize="10" Padding="4,0" ToolTip="Xóa tìm kiếm"/>
                        </Grid>
                    </Border>

                    <!-- Chrome Privacy / Hide Info Button with Options Menu -->
                    <Border Grid.Column="1" x:Name="BorderChromePrivacyToggle" Margin="8,0,0,0" CornerRadius="8" 
                            Background="{DynamicResource ThemeSecondaryBtnBg}" BorderBrush="{DynamicResource ThemeSecondaryBtnBorder}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnToggleChromePrivacyAll" Style="{StaticResource SecondaryBtn}" BorderThickness="0" Background="Transparent" Padding="9,5"
                                    Click="BtnToggleChromePrivacyAll_Click" MouseRightButtonUp="BtnChromePrivacy_MouseRightButtonUp" FocusVisualStyle="{x:Null}"
                                    ToolTip="Ẩn/Hiện thông tin tên và email tất cả profile Chrome (Chuột phải để chọn chi tiết)">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtChromePrivacyIcon" Text="👁" FontSize="11" Margin="0,0,4,0"/>
                                    <TextBlock x:Name="TxtChromePrivacyStatus" Text="Ẩn thông tin" FontWeight="SemiBold" FontSize="11"/>
                                </StackPanel>
                            </Button>
                            <!-- Divider -->
                            <Rectangle Width="1" Height="14" Fill="{DynamicResource ThemeSecondaryBtnBorder}" VerticalAlignment="Center"/>
                            <!-- Dropdown arrow pill -->
                            <Border x:Name="BorderChromePrivacyMenu" Cursor="Hand" Padding="7,4" Background="Transparent"
                                    MouseDown="BorderChromePrivacyMenu_MouseDown" ToolTip="Tùy chọn: Ẩn tất cả tên profile, Ẩn tất cả mail Google, hoặc Hiện tất cả">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ThemeSecondaryBtnHoverBg}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="▾" FontSize="9" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Profile Count Badge (Identical to Antigravity Count Badge) -->
                    <Border Grid.Column="2" Background="{DynamicResource ThemeToolbarBtnBg}" BorderBrush="{DynamicResource ThemeToolbarBtnBorder}" BorderThickness="1" 
                            CornerRadius="8" Padding="10,5" Margin="8,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtChromeTotalLabel" Text="Tổng:" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtProfileCount" Text=" (0)" FontSize="11.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Profiles Container (Identical scroll configuration to Antigravity IDE) -->
                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="ScrollChromeProfiles" VerticalScrollBarVisibility="Auto" Padding="0,0,4,12">
                        <ItemsControl x:Name="ProfilesItemsControl" ItemTemplate="{StaticResource ProfileItemTemplate}"/>
                    </ScrollViewer>

                    <!-- Empty state when search has no result -->
                    <Border x:Name="BorderEmptySearch" Background="{DynamicResource ThemeCardSubBg}" CornerRadius="10" Padding="16" Margin="0,14,0,0" 
                            HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🔍" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtEmptySearchText" Text="Không tìm thấy profile nào phù hợp!" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center"/>
                            <Button x:Name="BtnClearSearchBottom" Style="{StaticResource SecondaryBtn}" Content="Xóa tìm kiếm" Margin="0,8,0,0" Click="BtnClearSearch_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- 3. Bottom Settings Bar (Matching Antigravity Bottom Notice Card Styling) -->
            <!-- Bottom Settings Bar (Clean & Compact Single Row) -->
            <Border Grid.Row="2" Margin="16,0,16,8" Background="{DynamicResource ThemeBottomNoticeBg}" BorderBrush="{DynamicResource ThemeBottomNoticeBorder}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,5">
                        <TextBlock x:Name="TxtBottomSettingsHeader" Text="CƠ CHẾ THIẾT LẬP &amp; TỰ ĐỘNG BẢO VỆ" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="TxtBottomSettingsSub" Text=" • Bấm để bật/tắt tính năng" FontSize="10" Foreground="#475569" Margin="4,0,0,0"/>
                    </StackPanel>

                    <!-- 4-Column Single-Row Compact Grid (Chrome Protection Features) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Option 1: Shortcuts -->
                        <CheckBox x:Name="ChkShortcuts" Grid.Column="0" Style="{StaticResource OptionCardCheckBox}" 
                                  IsChecked="True" Checked="OnSettingChanged" Unchecked="OnSettingChanged"
                                  ToolTip="Mọi phím tắt Chrome khi bấm vào sẽ luôn mở đúng Profile đã set">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtChkShortcutsTitle" Text="Phím tắt Desktop/Taskbar" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtChkShortcutsSub" Text="Shortcut mở đúng Profile" FontSize="9.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                            </StackPanel>
                        </CheckBox>

                        <!-- Option 2: Registry -->
                        <CheckBox x:Name="ChkRegistry" Grid.Column="1" Style="{StaticResource OptionCardCheckBox}" 
                                  IsChecked="True" Checked="OnSettingChanged" Unchecked="OnSettingChanged"
                                  ToolTip="Ghi đè Registry ChromeHTML để khi bấm link ở ứng dụng khác cũng vào Profile này">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtChkRegistryTitle" Text="Mở link ngoài (Zalo, Mail)" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtChkRegistrySub" Text="Cấu hình mở đúng Profile" FontSize="9.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                            </StackPanel>
                        </CheckBox>

                        <!-- Option 3: Auto Guard -->
                        <CheckBox x:Name="ChkGuard" Grid.Column="2" Style="{StaticResource OptionCardCheckBox}" 
                                  IsChecked="True" Checked="OnSettingChanged" Unchecked="OnSettingChanged"
                                  ToolTip="Tránh việc bạn lướt tạm Profile khác làm Chrome tự đổi Profile mặc định">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtChkGuardTitle" Text="Tự động bảo vệ Profile" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtChkGuardSub" Text="Khôi phục khi tắt Chrome" FontSize="9.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                            </StackPanel>
                        </CheckBox>

                        <!-- Option 4: Startup -->
                        <CheckBox x:Name="ChkStartup" Grid.Column="3" Style="{StaticResource OptionCardCheckBox}" 
                                  IsChecked="False" Checked="OnSettingChanged" Unchecked="OnSettingChanged"
                                  ToolTip="Khởi động cùng Windows để duy trì bảo vệ tự động liên tục">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtChkStartupTitle" Text="Khởi động cùng Windows" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtChkStartupSub" Text="Chạy nền bảo vệ hệ thống" FontSize="9.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </Grid>
                </Grid>
            </Border>
        </Grid> <!-- End ViewChrome -->

        <!-- ======================================================= -->
        <!-- TAB 2: ANTIGRAVITY IDE VIEW -->
        <!-- ======================================================= -->
        <Grid x:Name="ViewAntigravity" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0: Hero Active Account Banner -->
                <RowDefinition Height="*"/>    <!-- 1: Search & Accounts List -->
            </Grid.RowDefinitions>

            <!-- 0. Hero Active Antigravity Account Banner -->
            <Border Grid.Row="0" Margin="16,8,16,6" CornerRadius="12" Padding="16,13" BorderThickness="1.5"
                    Background="{DynamicResource ThemeAntigravityHeroBg}" BorderBrush="{DynamicResource ThemeHeroBorderBrush}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Row 0: Account Info & Quick Action Buttons -->
                        <RowDefinition Height="Auto"/> <!-- Row 1: Detailed 20-Model Quota Grid -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Account Summary -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Hero Avatar / Monogram with Gemini Pro Ring -->
                        <Grid Grid.Column="0" Width="52" Height="52" Margin="0,0,14,0" VerticalAlignment="Center">
                            <!-- Gemini Pro Gradient Ring (Visible only for Pro active account) -->
                            <Border x:Name="BorderAntigravityHeroProRing" Width="52" Height="52" CornerRadius="26" BorderThickness="3" 
                                    BorderBrush="{StaticResource GeminiProRingBrush}" 
                                    Effect="{StaticResource GeminiProRingGlow}"
                                    Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <!-- Normal subtle outer ring (Visible only for Free active account) -->
                            <Border x:Name="BorderAntigravityHeroNormalRing" Width="48" Height="48" CornerRadius="24" BorderThickness="1.5" 
                                    BorderBrush="{DynamicResource ThemeAccountAvatarBorder}" 
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <!-- Inner Avatar Surface -->
                            <Grid Width="42" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border x:Name="BorderAntigravityHeroInitialBg" CornerRadius="21" Background="#00382B">
                                    <TextBlock x:Name="TxtAntigravityHeroInitial" Text="A" Foreground="#FFFFFF" FontWeight="Bold" 
                                               FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="BorderAntigravityHeroAvatar" CornerRadius="21" Visibility="Collapsed">
                                    <Border.Background>
                                        <ImageBrush x:Name="ImgAntigravityHeroAvatar" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- Hero Account Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <!-- Line 1: Badge + Name + GOOGLE + Plan Badge -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource ThemeActiveHeroBadgeBg}" BorderBrush="{DynamicResource ThemeActiveHeroBadgeBorder}" BorderThickness="1" CornerRadius="5" 
                                        Padding="6,1.5" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtHeroActiveBadge" Text="🚀 ĐANG DÙNG TRONG IDE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource ThemeActiveHeroBadgeFg}"/>
                                </Border>
                                <TextBlock x:Name="TxtAntigravityHeroName" Text="Chưa chọn tài khoản" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeHeroTitleFg}" VerticalAlignment="Center"
                                           Cursor="Hand" MouseDown="TxtHeroName_MouseDown" ToolTip="Nhấp chuột để ẩn/hiện tên tài khoản này"/>
                                
                                <!-- GOOGLE Badge -->
                                <Border Margin="8,0,4,0" CornerRadius="4" BorderBrush="{DynamicResource ThemeCardSubBorder}" Background="{DynamicResource ThemeCardSubBg}" BorderThickness="1" Padding="5,1" VerticalAlignment="Center">
                                    <TextBlock Text="GOOGLE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                </Border>

                                <!-- Plan Badge -->
                                <Border x:Name="BorderAntigravityHeroPlan" CornerRadius="5" Background="{DynamicResource ThemeCardSubBg}" BorderBrush="{DynamicResource ThemeCardSubBorder}" BorderThickness="1" Padding="7,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtAntigravityHeroPlan" Text="Google AI Pro" FontSize="10" Foreground="{DynamicResource ThemeEmailFg}" FontWeight="Black"/>
                                </Border>
                            </StackPanel>

                            <!-- Line 2: Email & 0 credits & Server Status -->
                            <WrapPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                                <Border Background="{DynamicResource ThemeCardSubBg}" CornerRadius="5" Padding="6,2" Margin="0,0,8,0"
                                        BorderBrush="{DynamicResource ThemeCardSubBorder}" BorderThickness="1" VerticalAlignment="Center"
                                        Cursor="Hand" MouseDown="TxtHeroEmail_MouseDown" MouseRightButtonUp="TxtHeroEmail_MouseRightButtonUp"
                                        ToolTip="Nhấp chuột trái: Ẩn/Hiện email | Nhấp chuột phải: Sao chép email">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📧 " FontSize="10" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtAntigravityHeroEmail" Text="Chưa đồng bộ" FontSize="11" 
                                                   Foreground="{DynamicResource ThemeEmailFg}" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource ThemeCardSubBg}" CornerRadius="5" Padding="6,2" Margin="0,0,8,0"
                                        BorderBrush="{DynamicResource ThemeCardSubBorder}" BorderThickness="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtAntigravityHeroCredits" Text="0 credits" FontSize="11" 
                                               Foreground="{DynamicResource ThemeEmailFg}" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="Số AI Credits bổ sung"/>
                                </Border>

                                <Border Background="{DynamicResource ThemeCardSubBg}" CornerRadius="5" Padding="6,2" Margin="0,0,8,0"
                                        BorderBrush="{DynamicResource ThemeCardSubBorder}" BorderThickness="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚡ " FontSize="10" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtAntigravityHeroStatus" Text="Language Server: Kết nối ổn định" 
                                                   FontSize="10.5" Foreground="{DynamicResource ThemeStatusRunningFg}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>

                                <!-- RAM Consumption Badge -->
                                <Border x:Name="BorderAntigravityHeroRam" Background="{DynamicResource ThemeCardSubBg}" CornerRadius="5" Padding="6,2" Margin="0,0,8,0"
                                        BorderBrush="{DynamicResource ThemeCardSubBorder}" BorderThickness="1" VerticalAlignment="Center"
                                        ToolTip="Lượng bộ nhớ RAM đang tiêu thụ bởi Antigravity IDE và AI Language Server">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💾 " FontSize="10" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtAntigravityHeroRam" Text="RAM: 0 MB" FontSize="10.5" 
                                                   Foreground="{DynamicResource ThemeNavActiveFg}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <!-- Line 3: Live Model Quotas & Toggle -->
                            <WrapPanel x:Name="PanelHeroModelQuotas" Orientation="Horizontal" Margin="0,5,0,0" VerticalAlignment="Center">
                                <!-- Gemini Quota -->
                                <Border x:Name="BorderHeroGeminiQuota" Background="{DynamicResource ThemeHeroGeminiQuotaBg}" BorderBrush="{DynamicResource ThemeHeroGeminiQuotaBorder}" BorderThickness="1" CornerRadius="5" Padding="6,2" Margin="0,0,6,0"
                                        ToolTip="Hạn mức mô hình Gemini Flash &amp; Pro">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="✦ Gemini: " FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ThemeHeroGeminiQuotaFg}"/>
                                        <TextBlock x:Name="TxtHeroGeminiQuota" Text="Đang tải..." FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeHeroGeminiQuotaValFg}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Claude & GPT Quota -->
                                <Border x:Name="BorderHeroClaudeQuota" Background="{DynamicResource ThemeHeroClaudeQuotaBg}" BorderBrush="{DynamicResource ThemeHeroClaudeQuotaBorder}" BorderThickness="1" CornerRadius="5" Padding="6,2" Margin="0,0,6,0"
                                        ToolTip="Hạn mức mô hình Claude Opus/Sonnet &amp; GPT-OSS">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="✳ Claude/GPT: " FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ThemeHeroClaudeQuotaFg}"/>
                                        <TextBlock x:Name="TxtHeroClaudeQuota" Text="Đang tải..." FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeHeroClaudeQuotaValFg}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Refresh Live Quota Button -->
                                <Border Cursor="Hand" Background="{DynamicResource ThemeSecondaryBtnBg}" BorderBrush="{DynamicResource ThemeSecondaryBtnBorder}" BorderThickness="1" CornerRadius="5" Padding="6,2" Margin="0,0,6,0"
                                        MouseDown="BtnRefreshLiveQuota_MouseDown" ToolTip="Bấm để kiểm tra lại hạn mức model trực tiếp từ Language Server">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🔄 " FontSize="9" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtHeroRemodulateQuota" Text="Đo lại Quota" FontSize="10" Foreground="{DynamicResource ThemeSecondaryBtnFg}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Toggle Detail Models View Button -->
                                <Border Cursor="Hand" Background="{DynamicResource ThemeSecondaryBtnBg}" BorderBrush="{DynamicResource ThemeSecondaryBtnBorder}" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,0,6,0"
                                        MouseDown="BtnToggleHeroQuota_MouseDown" ToolTip="Ẩn / hiện bảng chi tiết 20 model">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtHeroQuotaToggleIcon" Text="📊 Xem 20 Model Quota ▼" FontSize="10" Foreground="{DynamicResource ThemeNavActiveFg}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Open Large Dedicated Window Button -->
                                <Border Cursor="Hand" Background="{DynamicResource ThemeSecondaryBtnBg}" BorderBrush="{DynamicResource ThemeSecondaryBtnBorder}" BorderThickness="1" CornerRadius="5" Padding="6,2" 
                                        MouseDown="BtnOpenHeroQuotaWindow_MouseDown" ToolTip="Mở bảng hạn mức dưới dạng cửa sổ phóng to riêng biệt">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🔍 " FontSize="9" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtHeroSeparateWindow" Text="Cửa sổ riêng" FontSize="10" Foreground="{DynamicResource ThemeSecondaryBtnFg}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>

                        <!-- Hero Actions -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Reload Window Button -->
                            <Button x:Name="BtnHeroReloadIde" Style="{StaticResource PrimaryGreenBtn}" Padding="12,7" 
                                    Click="BtnHeroReloadIde_Click" ToolTip="Tải lại IDE tức thì trong 1 giây để áp dụng tài khoản mới mà không mất tab/file">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡ " FontSize="12"/>
                                    <TextBlock x:Name="TxtHeroReloadIde" Text="Tải lại IDE (1s)" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Expandable 3-Column 20-Model Detailed Quota Table (Matching Antigravity IDE UI) -->
                    <Border Grid.Row="1" x:Name="BorderHeroQuotaDetails" Margin="0,12,0,0" Padding="14,10" 
                            Background="{DynamicResource ThemeCardSubBg}" BorderBrush="{DynamicResource ThemeCardSubBorder}" BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
                        <StackPanel>
                            <!-- 3 Columns: 5 giờ -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/> <!-- 5 giờ label -->
                                    <ColumnDefinition Width="*"/>  <!-- 3 model columns -->
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtHero5hLabel" Grid.Column="0" Text="5 giờ" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,2,0,0"/>
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ItemsControl Grid.Column="0" x:Name="HeroItemsCol1" ItemTemplate="{StaticResource HeroModelQuotaItemTemplate}"/>
                                    <ItemsControl Grid.Column="1" x:Name="HeroItemsCol2" ItemTemplate="{StaticResource HeroModelQuotaItemTemplate}"/>
                                    <ItemsControl Grid.Column="2" x:Name="HeroItemsCol3" ItemTemplate="{StaticResource HeroModelQuotaItemTemplate}"/>
                                </Grid>
                            </Grid>

                            <!-- Weekly: Tuần -->
                            <Grid Margin="0,2,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/> <!-- Tuần label -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtHeroWeeklyLabel" Grid.Column="0" Text="Tuần" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,2,0,0"/>
                                <Grid Grid.Column="1">
                                    <ItemsControl x:Name="HeroItemsWeekly">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Width="170" Margin="0,2,32,4" ToolTip="{Binding TooltipText}" Cursor="Hand">
                                                    <Grid Margin="0,0,0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0">
                                                            <TextBlock Text="{Binding ResetCountdownText}" FontSize="9.5" Foreground="#94A3B8" HorizontalAlignment="Right"
                                                                       Visibility="{Binding ResetCountdownVisibility}" Margin="0,0,0,1"/>
                                                            <TextBlock Text="{Binding PercentDisplay}" FontSize="10" Foreground="{Binding PercentForeground}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <ProgressBar Style="{StaticResource HeroQuotaProgressBar}" 
                                                                 Width="170" Height="6" 
                                                                 Value="{Binding PercentValue, Mode=OneWay}" 
                                                                 Foreground="{Binding BarBrush}"
                                                                 HorizontalAlignment="Left"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Grid>

                            <!-- Footer note -->
                            <TextBlock x:Name="TxtHeroResetCountdown" Text="⏳ Claude/GPT hết hạn mức 5h, sẽ hồi phục sau 4h 27m (20:13) • Hạn mức tuần tính lại vào Chủ Nhật" 
                                       FontSize="10.5" Foreground="#FBBF24" Margin="60,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 1. Search Bar & Accounts List -->
            <Grid Grid.Row="1" Margin="16,4,16,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Search & Count Bar -->
                    <RowDefinition Height="Auto"/> <!-- Filter, Sort & Scope Toolbar -->
                    <RowDefinition Height="Auto"/> <!-- Recommended Next Account Card -->
                    <RowDefinition Height="*"/>    <!-- Accounts List -->
                </Grid.RowDefinitions>

                <!-- Search Box & Filter Bar -->
                <Border Grid.Row="0" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Input Box -->
                        <Border Grid.Column="0" Background="{DynamicResource ThemeInputBg}" BorderBrush="{DynamicResource ThemeInputBorder}" BorderThickness="1" CornerRadius="8" Padding="10,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtSearchAntigravity" Grid.Column="1" Background="Transparent" BorderThickness="0" 
                                         Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11.5" VerticalAlignment="Center"
                                         CaretBrush="#38BDF8" TextChanged="TxtSearchAntigravity_TextChanged"/>
                                <TextBlock x:Name="TxtSearchAntigravityPlaceholder" Grid.Column="1" Text="Tìm kiếm theo email, tên account..." FontSize="11.5" Foreground="{DynamicResource ThemeTextMuted}" 
                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtSearchAntigravity}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button x:Name="BtnClearAntigravitySearch" Grid.Column="2" Content="✕" Foreground="#94A3B8" 
                                         Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False" IsTabStop="False"
                                         Padding="4,0" FontSize="10" Click="BtnClearAntigravitySearch_Click" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- Batch Measure All Quota Button with Concurrency Selector -->
                        <Border Grid.Column="1" Margin="8,0,0,0" CornerRadius="8" Background="{DynamicResource ThemeSecondaryBtnBg}" BorderBrush="{DynamicResource ThemeSecondaryBtnBorder}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnRefreshAllAccountsQuota" Style="{StaticResource SecondaryBtn}" BorderThickness="0" Background="Transparent" Padding="9,5"
                                        Click="BtnRefreshAllAccountsQuota_Click" MouseRightButtonUp="BtnBatchMeasure_MouseRightButtonUp"
                                        ToolTip="Kích hoạt đo hạn mức trực tiếp cho toàn bộ tài khoản (Chuột phải để chọn số luồng)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⚡ " FontSize="11"/>
                                        <TextBlock x:Name="TxtBatchMeasureLabel" Text="Đo Quota Tất Cả Acc" FontWeight="SemiBold" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                                <!-- Divider -->
                                <Rectangle Width="1" Height="14" Fill="{DynamicResource ThemeSecondaryBtnBorder}" VerticalAlignment="Center"/>
                                <!-- Concurrency selector pill -->
                                <Border x:Name="BorderBatchConcurrency" Cursor="Hand" Padding="7,4" Background="Transparent"
                                        MouseDown="BorderBatchConcurrency_MouseDown" ToolTip="Nhấp chuột để chọn số luồng song song (1 - 15 luồng)">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ThemeSecondaryBtnHoverBg}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtBatchConcurrency" Text="5 luồng" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                        <TextBlock Text="▾" FontSize="9" Foreground="{DynamicResource ThemeTextSecondary}" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Auto Refresh All Quota Button with Interval Selector -->
                        <Border Grid.Column="2" x:Name="BorderAutoRefreshQuota" Margin="8,0,0,0" CornerRadius="8" 
                                Background="{DynamicResource ThemeSecondaryBtnBg}" BorderBrush="{DynamicResource ThemeSecondaryBtnBorder}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnToggleAutoRefresh" Style="{StaticResource SecondaryBtn}" BorderThickness="0" Background="Transparent" Padding="9,5"
                                        Click="BtnToggleAutoRefresh_Click" MouseRightButtonUp="BtnAutoRefresh_MouseRightButtonUp" FocusVisualStyle="{x:Null}"
                                        ToolTip="Bật/Tắt tự động đo Quota định kỳ cho toàn bộ tài khoản (Chuột phải để chọn chu kỳ)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtAutoRefreshIcon" Text="⏱" FontSize="11" Margin="0,0,4,0"/>
                                        <TextBlock x:Name="TxtAutoRefreshStatus" Text="Auto Quota: Tắt" FontWeight="SemiBold" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                                <!-- Divider -->
                                <Rectangle Width="1" Height="14" Fill="{DynamicResource ThemeSecondaryBtnBorder}" VerticalAlignment="Center"/>
                                <!-- Interval selector pill -->
                                <Border x:Name="BorderAutoRefreshInterval" Cursor="Hand" Padding="7,4" Background="Transparent"
                                        MouseDown="BorderAutoRefreshInterval_MouseDown" ToolTip="Nhấp chuột để chọn chu kỳ tự động đo (5p, 10p, 15p, 30p, 1h...)">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ThemeSecondaryBtnHoverBg}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtAutoRefreshInterval" Text="15m" FontSize="10" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"/>
                                        <TextBlock Text="▾" FontSize="9" Foreground="{DynamicResource ThemeTextSecondary}" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Privacy / Hide Info Button with Options Menu -->
                        <Border Grid.Column="3" x:Name="BorderPrivacyToggle" Margin="8,0,0,0" CornerRadius="8" 
                                Background="{DynamicResource ThemeSecondaryBtnBg}" BorderBrush="{DynamicResource ThemeSecondaryBtnBorder}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnTogglePrivacyAll" Style="{StaticResource SecondaryBtn}" BorderThickness="0" Background="Transparent" Padding="9,5"
                                        Click="BtnTogglePrivacyAll_Click" MouseRightButtonUp="BtnPrivacy_MouseRightButtonUp" FocusVisualStyle="{x:Null}"
                                        ToolTip="Ẩn/Hiện thông tin tên và email tất cả tài khoản (Chuột phải để chọn chi tiết)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtPrivacyIcon" Text="👁" FontSize="11" Margin="0,0,4,0"/>
                                        <TextBlock x:Name="TxtPrivacyStatus" Text="Ẩn thông tin" FontWeight="SemiBold" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                                <!-- Divider -->
                                <Rectangle Width="1" Height="14" Fill="{DynamicResource ThemeSecondaryBtnBorder}" VerticalAlignment="Center"/>
                                <!-- Dropdown arrow pill -->
                                <Border x:Name="BorderPrivacyMenu" Cursor="Hand" Padding="7,4" Background="Transparent"
                                        MouseDown="BorderPrivacyMenu_MouseDown" ToolTip="Tùy chọn: Ẩn tất cả tên, Ẩn tất cả mail, hoặc Hiện tất cả">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ThemeSecondaryBtnHoverBg}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="▾" FontSize="9" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Auto-Click Sign In Toggle Button in Toolbar -->
                        <Border Grid.Column="4" Margin="8,0,0,0" CornerRadius="8" Background="{DynamicResource ThemeSecondaryBtnBg}" BorderBrush="{DynamicResource ThemeSecondaryBtnBorder}" BorderThickness="1">
                            <Button x:Name="BtnToggleSilentSync" Style="{StaticResource SecondaryBtn}" BorderThickness="0" Background="Transparent" Padding="9,5"
                                    Click="BtnToggleSilentSync_Click" FocusVisualStyle="{x:Null}"
                                    ToolTip="Bật/Tắt tự động bấm nút 'Đăng nhập' / 'Sign in' khi mở trang Google OAuth (mặc định tắt)">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtSilentSyncIcon" Text="🖱️" FontSize="11" Margin="0,0,4,0"/>
                                    <TextBlock x:Name="TxtSilentSyncLabel" Text="Tự bấm Sign-in: Tắt" FontWeight="SemiBold" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- Account Count & Quick Refresh -->
                        <Border Grid.Column="5" Background="{DynamicResource ThemeToolbarBtnBg}" BorderBrush="{DynamicResource ThemeToolbarBtnBorder}" BorderThickness="1" 
                                CornerRadius="8" Padding="10,5" Margin="8,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtAntigravityTotalLabel" Text="Tổng:" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtAntigravityCount" Text=" (0)" FontSize="11.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Filter, Sort & Quota Scope Toolbar (Premium Dark Theme) -->
                <Grid Grid.Row="1" Margin="0,3,0,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Filter by Plan Button -->
                        <ColumnDefinition Width="Auto"/> <!-- Sort Button -->
                        <ColumnDefinition Width="Auto"/> <!-- Sort Direction Button (Lớn ➔ Nhỏ / Nhỏ ➔ Lớn) -->
                        <ColumnDefinition Width="Auto"/> <!-- Switch Target Pill (IDE | CLI | Antigravity) -->
                        <ColumnDefinition Width="*"/>    <!-- Spacer -->
                        <ColumnDefinition Width="Auto"/> <!-- Scope Segmented: Cả hai | 5 giờ | Tuần -->
                    </Grid.ColumnDefinitions>

                    <!-- Filter by Plan Button (Premium Dynamic Theme Style) -->
                    <Border Grid.Column="0" x:Name="BorderPlanFilter" Background="{DynamicResource ThemeToolbarBtnBg}" BorderBrush="{DynamicResource ThemeToolbarBtnBorder}" BorderThickness="1" 
                            CornerRadius="7" Padding="10,5,10,5" Cursor="Hand" MouseDown="BtnPlanFilter_Click"
                            ToolTip="Lọc theo gói tài khoản (Google AI Pro, Starter...)">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ThemeToolbarBtnHoverBg}"/>
                                        <Setter Property="BorderBrush" Value="#38BDF8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Vector Funnel Icon -->
                            <Path Width="11" Height="11" Stretch="Uniform" Fill="#38BDF8" Margin="0,0,7,0" VerticalAlignment="Center"
                                  Data="M1 1h14l-5.5 6.5v4.5l-3-1.5v-3z"/>
                            <TextBlock x:Name="TxtPlanFilterTitle" Text="Google AI Pro" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                            <TextBlock Text="▾" FontSize="10" Foreground="#64748B" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Sort Criteria Button (Premium Dynamic Theme Style) -->
                    <Border Grid.Column="1" x:Name="BorderSortFilter" Background="{DynamicResource ThemeToolbarBtnBg}" BorderBrush="{DynamicResource ThemeToolbarBtnBorder}" BorderThickness="1" 
                            CornerRadius="7" Padding="9,6" Margin="8,0,0,0" Cursor="Hand" MouseDown="BtnSortFilter_Click"
                            ToolTip="Sắp xếp danh sách tài khoản theo hạn mức, ngày dùng...">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ThemeToolbarBtnHoverBg}"/>
                                        <Setter Property="BorderBrush" Value="#38BDF8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Canvas Width="14" Height="13" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <!-- Arrow Up -->
                            <Path Data="M3 12V2 M3 2L1 4 M3 2L5 4" Stroke="#38BDF8" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <!-- 3 Sorted Horizontal Lines -->
                            <Path Data="M7.5 3H14 M7.5 7H12.5 M7.5 11H10.5" Stroke="#94A3B8" StrokeThickness="1.5" StrokeStartLineCap="Round"/>
                        </Canvas>
                    </Border>

                    <!-- Sort Direction Button (Lớn ➔ Nhỏ vs Nhỏ ➔ Lớn) -->
                    <Border Grid.Column="2" x:Name="BorderSortDirection" Background="{DynamicResource ThemeToolbarBtnBg}" 
                            BorderBrush="{DynamicResource ThemeToolbarBtnBorder}" BorderThickness="1" 
                            CornerRadius="7" Padding="9,5" Margin="8,0,0,0" Cursor="Hand" MouseDown="BtnSortDirection_Click"
                            ToolTip="Nhấp để đổi chiều sắp xếp: Lớn ➔ Nhỏ (Giảm dần) hoặc Nhỏ ➔ Lớn (Tăng dần)">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ThemeToolbarBtnHoverBg}"/>
                                        <Setter Property="BorderBrush" Value="#38BDF8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtSortDirectionIcon" Text="↓" FontSize="11.5" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSortDirectionLabel" Text="Quota: Lớn ➔ Nhỏ" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Switch Target Segmented Pill: IDE | CLI | Antigravity -->
                    <Border Grid.Column="3" Margin="10,0,0,0" Background="{DynamicResource ThemeNavBg}" 
                            BorderBrush="{DynamicResource ThemeNavBorder}" BorderThickness="1" 
                            CornerRadius="8" Padding="2.5" VerticalAlignment="Center"
                            ToolTip="Chọn ứng dụng mục tiêu khi Switch tài khoản (IDE, CLI, Antigravity)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Mục tiêu 1: Antigravity IDE (Mặc định) -->
                            <Border x:Name="BtnTargetIde" Cursor="Hand" CornerRadius="6" Padding="9,4" Margin="0,0,2,0"
                                    MouseDown="BtnTargetIde_MouseDown" Background="{DynamicResource ThemeNavActiveBg}"
                                    ToolTip="Antigravity IDE (2.0) - Tự động ghi DB và khởi động lại IDE (Mặc định)">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="💻 " FontSize="10.5" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtTargetIde" Text="IDE" FontSize="11.5" Foreground="{DynamicResource ThemeNavActiveFg}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Mục tiêu 2: Antigravity CLI -->
                            <Border x:Name="BtnTargetCli" Cursor="Hand" CornerRadius="6" Padding="9,4" Margin="0,0,2,0"
                                    MouseDown="BtnTargetCli_MouseDown" Background="Transparent"
                                    ToolTip="Antigravity CLI (agy) - Ghi Windows Credential Manager &amp; OAuth Token">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚡ " FontSize="10.5" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtTargetCli" Text="CLI" FontSize="11.5" Foreground="{DynamicResource ThemeNavInactiveFg}" FontWeight="Normal" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Mục tiêu 3: Antigravity Classic -->
                            <Border x:Name="BtnTargetAntigravity" Cursor="Hand" CornerRadius="6" Padding="9,4"
                                    MouseDown="BtnTargetAntigravity_MouseDown" Background="Transparent"
                                    ToolTip="Antigravity (1.x / Bản gốc) - Nạp cấu hình ứng dụng Antigravity">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🚀 " FontSize="10.5" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtTargetAntigravity" Text="Antigravity" FontSize="11.5" Foreground="{DynamicResource ThemeNavInactiveFg}" FontWeight="Normal" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Quota Scope Segmented: Cả hai | 5 giờ | Tuần (Dynamic Theme Pill) -->
                    <Border Grid.Column="5" Background="{DynamicResource ThemeNavBg}" BorderBrush="{DynamicResource ThemeNavBorder}" BorderThickness="1" CornerRadius="8" Padding="2.5">

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Cả hai -->
                            <Border x:Name="BtnScopeBoth" Cursor="Hand" CornerRadius="6" Padding="11,4" Margin="0,0,2,0"
                                    MouseDown="BtnScopeBoth_MouseDown" Background="Transparent">
                                <TextBlock x:Name="TxtScopeBoth" Text="Cả hai" FontSize="11.5" Foreground="{DynamicResource ThemeNavInactiveFg}" FontWeight="Normal" VerticalAlignment="Center"/>
                            </Border>

                            <!-- 5 giờ -->
                            <Border x:Name="BtnScope5h" Cursor="Hand" CornerRadius="6" Padding="10,4" Margin="0,0,2,0"
                                    MouseDown="BtnScope5h_MouseDown" Background="Transparent">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🕒 " FontSize="10.5" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtScope5h" Text="5 giờ" FontSize="11.5" Foreground="{DynamicResource ThemeNavInactiveFg}" FontWeight="Normal" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Tuần -->
                            <Border x:Name="BtnScopeWeekly" Cursor="Hand" CornerRadius="6" Padding="10,4"
                                    MouseDown="BtnScopeWeekly_MouseDown" Background="Transparent">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📅 " FontSize="10.5" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtScopeWeekly" Text="Tuần" FontSize="11.5" Foreground="{DynamicResource ThemeNavInactiveFg}" FontWeight="Normal" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Recommended Next Account Card (Banner) -->
                <Border Grid.Row="2" x:Name="BorderRecommendedAccount" Visibility="Collapsed" Margin="0,0,0,8"
                        Background="{DynamicResource ThemeNavBg}" 
                        BorderBrush="#38BDF8" BorderThickness="1.2" 
                        CornerRadius="8" Padding="12,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/> <!-- Avatar / Initial -->
                            <ColumnDefinition Width="*"/>    <!-- Account Info & Quota Reason -->
                            <ColumnDefinition Width="Auto"/> <!-- 1-Click Switch Button -->
                        </Grid.ColumnDefinitions>

                        <!-- Left: Initial / Avatar with Gemini Pro Ring -->
                        <Grid Grid.Column="0" Width="38" Height="38" VerticalAlignment="Center" Margin="0,0,10,0">
                            <!-- Gemini Pro Gradient Ring (Visible only for Pro recommended account) -->
                            <Border x:Name="BorderRecProRing" Width="38" Height="38" CornerRadius="19" BorderThickness="2"
                                    BorderBrush="{StaticResource GeminiProRingBrush}"
                                    Effect="{StaticResource GeminiProRingGlow}"
                                    Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <!-- Subtle normal border -->
                            <Border x:Name="BorderRecNormalRing" Width="34" Height="34" CornerRadius="17" BorderThickness="1"
                                    BorderBrush="{DynamicResource ThemeAccountAvatarBorder}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <!-- Inner Avatar Surface -->
                            <Border x:Name="BorderRecInitialBg" Width="30" Height="30" CornerRadius="15" 
                                    Background="#0284C7" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtRecInitial" Text="G" FontSize="13" FontWeight="Bold" 
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Center: Account Info & Quota stats -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#0284C7" CornerRadius="4" Padding="5,1.5" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtRecBadge" Text="✨ ĐỀ XUẤT TIẾP THEO" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <!-- Recommendation Rule Setting Selector -->
                                <Border x:Name="BorderRecRule" Background="{DynamicResource ThemeSecondaryBtnBg}" BorderBrush="{DynamicResource ThemeSecondaryBtnBorder}" BorderThickness="1" 
                                        CornerRadius="4" Padding="6,1.5" Margin="0,0,7,0" VerticalAlignment="Center" Cursor="Hand" 
                                        MouseDown="BorderRecRule_MouseDown" ToolTip="Nhấp chuột để thay đổi quy định đề xuất tài khoản (Ưu tiên PRO, Chỉ PRO, Claude cao nhất...)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⚙ " FontSize="9" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtRecRuleName" Text="Ưu tiên PRO" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                        <TextBlock Text=" ▾" FontSize="9" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="TxtRecName" Text="Tài khoản" FontSize="12" FontWeight="Bold" 
                                           Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"
                                           Cursor="Hand" MouseDown="TxtRecName_MouseDown" ToolTip="Nhấp chuột để ẩn/hiện tên tài khoản đề xuất"/>
                                <!-- Rec Plan Badge -->
                                <Border x:Name="BorderRecPlanBadge" CornerRadius="5" Background="{DynamicResource ThemeCardSubBg}" BorderBrush="{DynamicResource ThemeCardSubBorder}" BorderThickness="1" Padding="6.5,1.5" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock x:Name="TxtRecPlanBadge" Text="✦ PRO" FontSize="9.5" FontWeight="Black" Foreground="White"/>
                                </Border>
                                <TextBlock x:Name="TxtRecEmail" Text="email@gmail.com" FontSize="11" 
                                           Foreground="{DynamicResource ThemeTextMuted}" Margin="6,0,0,0" VerticalAlignment="Center"
                                           Cursor="Hand" MouseDown="TxtRecEmail_MouseDown" ToolTip="Nhấp chuột trái: Ẩn/hiện email • Chuột phải: Sao chép" MouseRightButtonUp="TxtRecEmail_MouseRightButtonUp"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtRecQuotaBadges" Text="✦ Gemini: 100% • ✳ Claude: 100%" FontSize="10.5" 
                                           Foreground="#10B981" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtRecReason" Text="• Hạn mức cao nhất, sẵn sàng sử dụng" FontSize="10.5" 
                                           Foreground="{DynamicResource ThemeTextSecondary}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right: 1-Click Switch Button -->
                        <Button x:Name="BtnQuickSwitchRecommended" Grid.Column="2" 
                                Style="{StaticResource PrimaryGreenBtn}" Padding="12,5" Margin="8,0,0,0"
                                VerticalAlignment="Center" Click="BtnQuickSwitchRecommended_Click" Cursor="Hand"
                                ToolTip="Chuyển ngay sang tài khoản có hạn mức tốt nhất này">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚡ " FontSize="11"/>
                                <TextBlock x:Name="TxtRecSwitchBtn" Text="Switch" FontWeight="SemiBold" FontSize="11.5"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Accounts ScrollViewer & ItemsControl -->
                <ScrollViewer x:Name="ScrollAntigravityAccounts" Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,4,2">
                    <ItemsControl x:Name="AntigravityItemsControl" ItemTemplate="{StaticResource AntigravityAccountTemplate}"/>
                </ScrollViewer>
            </Grid>
        </Grid> <!-- End ViewAntigravity -->
    </Grid>

        <!-- =================================================================== -->
        <!-- CUSTOM IN-APP MODAL: GOOGLE ACCOUNTS LIST -->
        <!-- =================================================================== -->
        <Grid x:Name="AccountsModalOverlay" Panel.ZIndex="1000" Visibility="Collapsed">
            <!-- Frosted Backdrop -->
            <Border Background="#45000000" MouseDown="AccountsModalBackdrop_MouseDown"/>

            <!-- Accounts Dialog Box -->
            <Border Width="560" MaxHeight="480" Background="{DynamicResource ThemeModalBg}" BorderBrush="{DynamicResource ThemeModalBorder}" BorderThickness="1" 
                    CornerRadius="16" Padding="20,16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Color="#000000" Opacity="0.16" Direction="270" ShadowDepth="4"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="*"/>    <!-- Accounts List -->
                        <RowDefinition Height="Auto"/> <!-- Footer -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👥 " FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtAccountsModalTitle" Text="Tài khoản Google trong Profile" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                                <Border x:Name="BorderAccountsModalCount" Background="{DynamicResource ThemeCardSubBg}" BorderBrush="{DynamicResource ThemeCardSubBorder}" BorderThickness="1" CornerRadius="5" Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtAccountsModalCount" Text="1" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeNavActiveFg}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="TxtAccountsModalProfileName" Text="Profile: Cá nhân 1 (Default)" FontSize="11.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,3,0,0"/>
                        </StackPanel>

                        <Button x:Name="BtnCloseAccountsModalTop" Grid.Column="1" Content="✕" Foreground="{DynamicResource ThemeTextSecondary}" Background="Transparent" BorderThickness="0" 
                                Cursor="Hand" Click="BtnCloseAccountsModal_Click" FontSize="13" Padding="6,2" ToolTip="Đóng"/>
                    </Grid>

                    <!-- Content Stack -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <!-- Batch Sync Progress Banner with Instant Stop Button -->
                        <Border x:Name="BorderBatchSyncProgress" Background="{DynamicResource ThemeCardSubBg}" 
                                BorderBrush="{DynamicResource ThemeNavActiveFg}" BorderThickness="1" CornerRadius="8" 
                                Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚡ " FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtBatchSyncProgress" Text="Đang đồng bộ..." FontSize="12" 
                                               FontWeight="SemiBold" Foreground="{DynamicResource ThemeNavActiveFg}" 
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button x:Name="BtnCancelSyncBanner" Grid.Column="1" Style="{StaticResource DangerBtn}" Padding="10,4" Margin="8,0,0,0"
                                        Click="BtnCancelSyncInModal_Click" ToolTip="Dừng ngay lập tức toàn bộ quá trình đồng bộ hàng loạt">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⏹ " FontSize="10.5" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtCancelSyncBannerText" Text="Dừng đồng bộ" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Accounts Scroll List -->
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="AccountsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource ThemeCardSubBg}" BorderBrush="{DynamicResource ThemeCardSubBorder}" BorderThickness="1" CornerRadius="8" 
                                                Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Monogram Avatar -->
                                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" 
                                                        Background="{Binding InitialBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding InitialLetter}" Foreground="#FFFFFF" FontWeight="Bold" 
                                                               FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Details -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayNameMasked}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource ThemeTextPrimary}"
                                                                   Cursor="Hand" MouseDown="TxtGoogleAccountName_MouseDown" ToolTip="{Binding AccountNameTooltip}"/>
                                                        <!-- Primary Badge -->
                                                        <Border Margin="8,0,0,0" Background="{DynamicResource ThemeStatusRunningBg}" BorderBrush="{DynamicResource ThemeStatusRunningBorder}" BorderThickness="1" 
                                                                CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding PrimaryBadgeText}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeStatusRunningFg}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding EmailMasked}" FontSize="11" Foreground="{DynamicResource ThemeEmailFg}" Margin="0,1,0,0"
                                                               Cursor="Hand" MouseDown="TxtGoogleAccountEmail_MouseDown" ToolTip="{Binding AccountEmailTooltip}" MouseRightButtonUp="TxtGoogleAccountEmail_MouseRightButtonUp"/>
                                                </StackPanel>

                                                <!-- Action Buttons: Sync to Antigravity + Copy Email -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Sync to Antigravity Button -->
                                                    <Button Style="{StaticResource PrimaryGreenBtn}" Padding="9,4" Margin="0,0,6,0"
                                                            Tag="{Binding}" Click="BtnSyncAccountToAntigravity_Click"
                                                            ToolTip="{Binding SyncButtonTooltip}">
                                                        <TextBlock Text="{Binding SyncButtonText}" FontSize="10.5" FontWeight="SemiBold"/>
                                                    </Button>

                                                    <!-- Copy Button -->
                                                    <Button Style="{StaticResource SecondaryBtn}" Padding="8,4" 
                                                            Tag="{Binding Email}" Click="BtnCopyAccountEmail_Click" ToolTip="{Binding CopyButtonTooltip}" 
                                                            VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📋 " FontSize="10"/>
                                                            <TextBlock Text="{Binding CopyButtonText}" FontSize="10.5"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Footer Action -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnBatchSyncAllInModal" Style="{StaticResource PrimaryGreenBtn}" 
                                Content="⚡ Đồng bộ tất cả vào Antigravity" 
                                Padding="14,6" Margin="0,0,10,0" Click="BtnBatchSyncAllInModal_Click"
                                ToolTip="Đồng bộ toàn bộ tài khoản Google trong Profile này vào Antigravity (bấm xác nhận trên trình duyệt, tab tự đóng khi hoàn tất)"/>
                        <Button x:Name="BtnCancelSyncInModal" Style="{StaticResource DangerBtn}" 
                                Padding="14,6" Margin="0,0,10,0" Visibility="Collapsed" Click="BtnCancelSyncInModal_Click"
                                ToolTip="Dừng ngay lập tức toàn bộ quá trình đồng bộ đang chạy">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏹ " FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCancelSyncInModalText" Text="Dừng đồng bộ" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnCloseAccountsModalBottom" Style="{StaticResource SecondaryBtn}" Content="Đóng" Padding="18,6" Click="BtnCloseAccountsModal_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- CUSTOM IN-APP MODAL: CUSTOM AUTO REFRESH INTERVAL -->
        <!-- =================================================================== -->
        <Grid x:Name="CustomIntervalModalOverlay" Panel.ZIndex="1000" Visibility="Collapsed">
            <!-- Frosted Backdrop with soft fade -->
            <Border Background="#45000000" MouseDown="CustomIntervalModalBackdrop_MouseDown"/>

            <!-- Dialog Box Container -->
            <Border Width="470" Background="{DynamicResource ThemeModalBg}" BorderBrush="{DynamicResource ThemeModalBorder}" BorderThickness="1" 
                    CornerRadius="16" Padding="24,20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Color="#000000" Opacity="0.16" Direction="270" ShadowDepth="4"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- 0: Header & Close Button -->
                        <RowDefinition Height="Auto"/> <!-- 1: Info / Hint Box -->
                        <RowDefinition Height="Auto"/> <!-- 2: Value + Unit Input Group -->
                        <RowDefinition Height="Auto"/> <!-- 3: Quick Presets Section -->
                        <RowDefinition Height="Auto"/> <!-- 4: Footer Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Header (Gradient Icon Badge, Title, Subtitle, Close Button) -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Gradient Icon Badge -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#10B981" Offset="0"/>
                                    <GradientStop Color="#059669" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Color="#10B981" Opacity="0.4" Direction="270" ShadowDepth="2"/>
                            </Border.Effect>
                            <TextBlock Text="⏱" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                        </Border>

                        <!-- Header Text -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtCustomIntervalTitle" Text="Tùy Chỉnh Chu Kỳ Đo Quota" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                            <TextBlock x:Name="TxtCustomIntervalSub" Text="Cài đặt tần suất tự động kiểm tra hạn mức AI" FontSize="11.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Close Button -->
                        <Button x:Name="BtnCustomIntervalClose" Grid.Column="2" Style="{StaticResource ModernModalCloseBtn}" Content="✕" 
                                ToolTip="Đóng (Hủy bỏ)" Click="BtnCustomIntervalCancel_Click" VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Row 1: Modern Info Hint Banner -->
                    <Border Grid.Row="1" Background="{DynamicResource ThemeCardSubBg}" BorderBrush="{DynamicResource ThemeCardSubBorder}" 
                            BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="💡" FontSize="12.5" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtCustomIntervalHint" Grid.Column="1" Text="Nhập khoảng thời gian bạn muốn hệ thống tự động kiểm tra Quota (tối thiểu 5 giây, tối đa 7 ngày)." 
                                       FontSize="11.5" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Row 2: Inputs (Label + Number Input + Unit ComboBox) -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,16">
                        <TextBlock x:Name="TxtCustomIntervalInputLabel" Text="Khoảng thời gian chu kỳ:" FontSize="12" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="135"/>
                            </Grid.ColumnDefinitions>

                            <!-- Number TextBox with Icon and Focus Highlight -->
                            <Border Grid.Column="0" Background="{DynamicResource ThemeInputBg}" BorderThickness="1.5" 
                                    CornerRadius="8" Padding="12,0" Height="40" Margin="0,0,10,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorder}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFocused, ElementName=TxtCustomIntervalInput}" Value="True">
                                                <Setter Property="BorderBrush" Value="#10B981"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⏱" FontSize="13" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtCustomIntervalInput" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource ThemeTextPrimary}" FontSize="15" FontWeight="Bold"
                                             VerticalAlignment="Center" CaretBrush="#10B981" Text="15" PreviewTextInput="TxtCustomInterval_PreviewTextInput"/>
                                </Grid>
                            </Border>

                            <!-- Modern Styled Unit ComboBox -->
                            <ComboBox x:Name="CmbCustomIntervalUnit" Grid.Column="1" Style="{StaticResource ModernModalComboBox}" 
                                      ItemContainerStyle="{StaticResource ModernModalComboBoxItem}" Height="40" SelectedIndex="1">
                                <ComboBoxItem x:Name="CmbItemSeconds" Content="Giây (s)"/>
                                <ComboBoxItem x:Name="CmbItemMinutes" Content="Phút (m)"/>
                                <ComboBoxItem x:Name="CmbItemHours" Content="Giờ (h)"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>

                    <!-- Row 3: Quick Presets Section -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,20">
                        <TextBlock x:Name="TxtCustomIntervalPresetsLabel" Text="⚡ Chọn nhanh chu kỳ gợi ý:" FontSize="11.5" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,8"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button Content="15s" Tag="15s" Style="{StaticResource PresetChipBtn}" Click="BtnPresetInterval_Click"/>
                            <Button Content="30s" Tag="30s" Style="{StaticResource PresetChipBtn}" Click="BtnPresetInterval_Click"/>
                            <Button Content="1m" Tag="1m" Style="{StaticResource PresetChipBtn}" Click="BtnPresetInterval_Click"/>
                            <Button Content="2m" Tag="2m" Style="{StaticResource PresetChipBtn}" Click="BtnPresetInterval_Click"/>
                            <Button Content="3m" Tag="3m" Style="{StaticResource PresetChipBtn}" Click="BtnPresetInterval_Click"/>
                            <Button Content="5m" Tag="5m" Style="{StaticResource PresetChipBtn}" Click="BtnPresetInterval_Click"/>
                            <Button Content="10m" Tag="10m" Style="{StaticResource PresetChipBtn}" Click="BtnPresetInterval_Click"/>
                            <Button Content="15m" Tag="15m" Style="{StaticResource PresetChipBtn}" Click="BtnPresetInterval_Click"/>
                            <Button Content="30m" Tag="30m" Style="{StaticResource PresetChipBtn}" Click="BtnPresetInterval_Click"/>
                            <Button Content="1h" Tag="1h" Style="{StaticResource PresetChipBtn}" Click="BtnPresetInterval_Click"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Row 4: Divider & Action Buttons -->
                    <Border Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ThemeCardSubBorder}" Padding="0,14,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnCustomIntervalCancel" Style="{StaticResource SecondaryBtn}" Content="Hủy bỏ" Height="36" Padding="18,0" 
                                    Margin="0,0,10,0" Click="BtnCustomIntervalCancel_Click"/>
                            <Button Style="{StaticResource PrimaryGreenBtn}" Height="36" Padding="20,0" 
                                    Click="BtnCustomIntervalApply_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="✓" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtCustomIntervalApplyText" Text="Áp dụng &amp; Bật" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- CUSTOM IN-APP MODAL: CONFIRMATION / ALERT DIALOG (TOP-MOST MODAL LAYER) -->
        <!-- Placed after other modals with Panel.ZIndex=3000 so it always sits on top -->
        <!-- =================================================================== -->
        <Grid x:Name="CustomModalOverlay" Panel.ZIndex="3000" Visibility="Collapsed">
            <!-- Frosted Soft Dark Backdrop -->
            <Border Background="#45000000" MouseDown="ModalBackdrop_MouseDown"/>

            <!-- Dialog Box -->
            <Border x:Name="BorderCustomModalBox" Width="480" Background="{DynamicResource ThemeModalBg}" BorderBrush="{DynamicResource ThemeModalBorder}" BorderThickness="1" 
                    CornerRadius="16" Padding="22,18" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Color="#000000" Opacity="0.16" Direction="270" ShadowDepth="4"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header (Icon, Title, Badge, Close) -->
                        <RowDefinition Height="Auto"/> <!-- Message Content or Rich Details -->
                        <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon Badge -->
                        <Border x:Name="ModalIconBorder" Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#450A0A" 
                                BorderBrush="#991B1B" BorderThickness="1.5" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtModalIcon" Text="🛑" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Title + Count Badge + Subtitle -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtModalTitle" Text="Xác nhận thao tác" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                <Border x:Name="BorderModalCountBadge" Visibility="Collapsed" Background="{DynamicResource ThemeCardSubBg}" 
                                        BorderBrush="{DynamicResource ThemeCardSubBorder}" BorderThickness="1" CornerRadius="5" Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtModalCountBadge" Text="10 tài khoản" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ThemeNavActiveFg}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="TxtModalSubtitle" Text="Đồng bộ an toàn cấu hình" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Top-Right Close Button -->
                        <Button Grid.Column="2" Content="✕" Foreground="{DynamicResource ThemeTextSecondary}" Background="Transparent" BorderThickness="0" 
                                Cursor="Hand" Click="BtnModalCancel_Click" FontSize="13" Padding="6,2" VerticalAlignment="Top" ToolTip="Đóng"/>
                    </Grid>

                    <!-- Content Row: Mode 1 (Normal Text) & Mode 2 (Rich Batch Sync) -->
                    <Grid Grid.Row="1">
                        <!-- Mode 1: Normal Message -->
                        <StackPanel x:Name="PanelNormalMessage">
                            <TextBlock x:Name="TxtModalMessage" Text="Nội dung thông báo..." 
                                       FontSize="12.5" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16"/>
                        </StackPanel>

                        <!-- Mode 2: Rich Batch Sync Details -->
                        <StackPanel x:Name="PanelBatchSyncDetails" Visibility="Collapsed" Margin="0,0,0,14">
                            <!-- Accounts Preview Box -->
                            <Border Background="{DynamicResource ThemeCardSubBg}" BorderBrush="{DynamicResource ThemeCardSubBorder}" 
                                    BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock x:Name="TxtBatchSyncHeaderTitle" Text="DANH SÁCH TÀI KHOẢN CHỜ ĐỒNG BỘ" FontSize="9.5" FontWeight="Bold" 
                                               Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,0,8"/>
                                    
                                    <StackPanel x:Name="PanelBatchSyncAccountItems"/>

                                    <TextBlock x:Name="TxtBatchSyncMoreAccounts" Text="...và 5 tài khoản khác" 
                                               FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}" 
                                               Margin="4,4,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <!-- Guidance Banner -->
                            <Border Background="{DynamicResource ThemeStatusIndicatorBg}" BorderBrush="{DynamicResource ThemeStatusIndicatorBorder}" 
                                    BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="💡" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                    <TextBlock x:Name="TxtBatchSyncGuidance" Grid.Column="1" Text="Trình duyệt Chrome sẽ lần lượt mở từng tài khoản để bạn xác nhận. Hệ thống sẽ tự đóng tab và lưu token vào Antigravity ngay khi hoàn tất." 
                                               FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" LineHeight="16"/>
                                </Grid>
                            </Border>

                            <!-- Auto-Click Quick Toggle Card -->
                            <Border Background="{DynamicResource ThemeOptionCardBg}" BorderBrush="{DynamicResource ThemeOptionCardBorder}" 
                                    BorderThickness="1" CornerRadius="8" Padding="10,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtAutoClickInModalTitle" Text="⚡ Tự động bấm nút Đăng nhập (Auto-Click)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                        <TextBlock x:Name="TxtAutoClickInModalSub" Text="Chỉ click khi phát hiện đúng nút Đăng nhập trên màn hình" FontSize="9.5" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkAutoClickInModal" Grid.Column="1" VerticalAlignment="Center" 
                                              Cursor="Hand" Click="ChkAutoClickInModal_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <!-- Cancel Button -->
                        <Button x:Name="BtnModalCancel" Style="{StaticResource SecondaryBtn}" Content="Hủy bỏ" 
                                Padding="16,7" Margin="0,0,10,0" Click="BtnModalCancel_Click"/>

                        <!-- Confirm Button -->
                        <Button x:Name="BtnModalConfirm" Style="{StaticResource DangerBtn}" Content="Đồng ý đóng" 
                                Padding="20,7" Click="BtnModalConfirm_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- ABOUT & AUTHOR INFO MODAL (Popup Thông tin Tác giả, GitHub, Telegram) -->
        <!-- =================================================================== -->
        <Grid x:Name="AboutModalOverlay" Panel.ZIndex="3100" Visibility="Collapsed" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <!-- Frosted Soft Dark Backdrop -->
            <Border x:Name="AboutModalBackdrop" Background="#45000000" MouseDown="AboutModalBackdrop_MouseDown"/>

            <!-- Dialog Box -->
            <Border x:Name="AboutModalCard" Width="480" Background="{DynamicResource ThemeModalBg}" BorderBrush="{DynamicResource ThemeModalBorder}" BorderThickness="1" 
                    CornerRadius="16" Padding="24,20" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="AboutModalTranslate" Y="0"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Color="#000000" Opacity="0.22" Direction="270" ShadowDepth="4" RenderingBias="Performance"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Content Cards -->
                        <RowDefinition Height="Auto"/> <!-- Footer Actions -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- High-Definition Gradient App Logo Badge -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0284C7" Offset="0"/>
                                    <GradientStop Color="#2563EB" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M 12,2 L 2,7 L 12,12 L 22,7 Z M 2,17 L 12,22 L 22,17 M 2,12 L 12,17 L 22,12" 
                                      Stroke="#FFFFFF" StrokeThickness="2" StrokeLineJoin="Round" Stretch="Uniform"/>
                            </Grid>
                        </Border>

                        <!-- Title & Subtitle -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Antigravity Hub" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                <Border Background="{DynamicResource ThemeCardSubBg}" BorderBrush="{DynamicResource ThemeNavActiveBorder}" BorderThickness="1" CornerRadius="5" Padding="5,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="v2.5 Pro" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeNavActiveFg}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="TxtAboutModalSubtitle" Text="Hệ sinh thái Quản trị Antigravity AI &amp; Workspace Chrome Profiles" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Close Button -->
                        <Button Grid.Column="2" Content="✕" Foreground="{DynamicResource ThemeTextSecondary}" Background="Transparent" BorderThickness="0" 
                                Cursor="Hand" Click="BtnCloseAboutModal_Click" FontSize="14" FontWeight="Bold" Padding="6,2" VerticalAlignment="Top" ToolTip="Đóng"/>
                    </Grid>

                    <!-- Content Cards (Author, GitHub, Telegram) -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,16">
                        <!-- 1. Author Info Card -->
                        <Border Background="{DynamicResource ThemeCardSubBg}" BorderBrush="{DynamicResource ThemeCardSubBorder}" BorderThickness="1" CornerRadius="11" Padding="14,11" Margin="0,0,0,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Vector Developer Badge Icon -->
                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Path Data="M 12,12 C 14.21,12 16,10.21 16,8 16,5.79 14.21,4 12,4 9.79,4 8,5.79 8,8 8,10.21 9.79,12 12,12 Z M 12,14 C 9.33,14 4,15.34 4,18 V 20 H 20 V 18 C 20,15.34 14.67,14 12,14 Z" 
                                          Fill="#4F46E5" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Text -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtAboutLabelAuthor" Text="TÁC GIẢ PHÁT TRIỂN" FontSize="10" FontWeight="Bold" Foreground="#4F46E5"/>
                                    <TextBlock Text="Phùng Toàn (DvenxyWiks)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,1,0,0"/>
                                    <TextBlock Text="phungtoan2006@gmail.com" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                </StackPanel>

                                <!-- Copy Email Button -->
                                <Button Grid.Column="2" Style="{StaticResource SubBarSecondaryBtn}" Height="28" Padding="10,0" Click="BtnCopyEmail_Click" ToolTip="Sao chép địa chỉ Email" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📋" FontSize="10.5" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtAboutBtnCopyEmail" Text="Copy" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 2. GitHub Card -->
                        <Border Background="{DynamicResource ThemeCardSubBg}" BorderBrush="{DynamicResource ThemeCardSubBorder}" BorderThickness="1" CornerRadius="11" Padding="14,11" Margin="0,0,0,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- GitHub High-Contrast Octocat Vector Icon -->
                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeHeaderBorder}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Path Data="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" 
                                          Fill="{DynamicResource ThemeTextPrimary}" Width="19" Height="19" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Text -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="GITHUB REPOSITORY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeNavActiveFg}"/>
                                    <TextBlock Text="github.com/wiksgods" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,1,0,0"/>
                                    <TextBlock x:Name="TxtAboutDescGithub" Text="Mã nguồn dự án &amp; Bản cập nhật mới nhất" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                </StackPanel>

                                <!-- Actions (Open & Copy) -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SubBarSecondaryBtn}" Height="28" Padding="9,0" Margin="0,0,5,0" Click="BtnCopyGithub_Click" ToolTip="Sao chép liên kết GitHub">
                                        <TextBlock x:Name="TxtAboutBtnCopyGithub" Text="Copy" FontSize="11" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button Style="{StaticResource SubBarGreenBtn}" Height="28" Padding="10,0" Click="BtnOpenGithub_Click" ToolTip="Mở GitHub trên trình duyệt">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="↗" FontSize="11.5" FontWeight="Bold" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtAboutBtnOpenGithub" Text="Mở" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 3. Telegram Card -->
                        <Border Background="{DynamicResource ThemeCardSubBg}" BorderBrush="{DynamicResource ThemeCardSubBorder}" BorderThickness="1" CornerRadius="11" Padding="14,11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Telegram Vector Icon -->
                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Path Data="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.562 8.161c-.18.894-1.62 7.781-1.74 8.358-.084.407-.29.54-.492.548-.445.016-.782-.266-1.214-.548-.675-.443-1.056-.719-1.711-1.15-.757-.499-.266-.773.165-1.221.113-.117 2.072-1.9 2.11-2.062.005-.02.009-.098-.037-.139-.047-.04-.114-.027-.164-.016-.07.016-1.196.762-3.376 2.233-.319.219-.608.327-.866.321-.285-.006-.834-.161-1.242-.294-.501-.163-.899-.249-.864-.526.018-.145.218-.293.6-.445 2.348-1.023 3.915-1.698 4.701-2.025 2.234-.93 2.698-1.092 3.001-1.097.067-.001.215.016.311.094.081.066.104.155.114.218.01.065.023.212.012.327z" 
                                          Fill="#0088CC" Width="19" Height="19" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Text -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="KÊNH TELEGRAM TRỰC TIẾP" FontSize="10" FontWeight="Bold" Foreground="#0284C7"/>
                                    <TextBlock Text="@DvenxyWiks" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,1,0,0"/>
                                    <TextBlock x:Name="TxtAboutDescTele" Text="Liên hệ hỗ trợ &amp; trao đổi nhanh" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                </StackPanel>

                                <!-- Actions (Open & Copy) -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SubBarSecondaryBtn}" Height="28" Padding="9,0" Margin="0,0,5,0" Click="BtnCopyTelegram_Click" ToolTip="Sao chép tên người dùng Telegram">
                                        <TextBlock x:Name="TxtAboutBtnCopyTele" Text="Copy" FontSize="11" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button Style="{StaticResource SubBarGreenBtn}" Height="28" Padding="10,0" Click="BtnOpenTelegram_Click" ToolTip="Mở Telegram để nhắn tin">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="↗" FontSize="11.5" FontWeight="Bold" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtAboutBtnOpenTele" Text="Nhắn" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Footer Action -->
                    <Grid Grid.Row="2">
                        <TextBlock Text="Made with ❤️ by Phùng Toàn (DvenxyWiks)" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <Button Style="{StaticResource SecondaryBtn}" Content="Đóng" Padding="22,6" HorizontalAlignment="Right" Click="BtnCloseAboutModal_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- FLOATING BOTTOM TOAST NOTIFICATION (Top-most Layer, Themed Capsule) -->
        <!-- =================================================================== -->
        <Border x:Name="ToastBanner" Panel.ZIndex="99999" 
                VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24" 
                Background="{DynamicResource ThemeToastBg}" BorderBrush="{DynamicResource ThemeToastBorder}" 
                BorderThickness="1" CornerRadius="16" Padding="14,7,12,7" 
                Visibility="Collapsed" Opacity="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" Color="#0F172A" Opacity="0.16" Direction="270" ShadowDepth="3"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Toast Text Content (Single clean message with natural icon) -->
                <TextBlock x:Name="TxtToastMessage" Text="Đã thực hiện thành công!" 
                           FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeToastFg}" 
                           VerticalAlignment="Center" MaxWidth="540" TextTrimming="CharacterEllipsis"/>
                
                <!-- Minimal Close Button -->
                <Button x:Name="BtnCloseToast" Cursor="Hand" Click="BtnCloseToast_Click" 
                        Margin="12,0,0,0" VerticalAlignment="Center" FocusVisualStyle="{x:Null}"
                        ToolTip="Đóng">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder" Width="18" Height="18" CornerRadius="9" Background="Transparent">
                                <TextBlock Text="✕" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource ThemeToastCloseFg}" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource ThemeToastCloseHoverBg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
    </Border>
</Window>
