<Window x:Class="ProfileSwitchChrome.ModelQuotaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bảng Hạn Mức Model Quota - Antigravity IDE"
        Height="630" Width="920" MinHeight="540" MinWidth="860"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeWindowBg}"
        Foreground="{DynamicResource ThemeTextPrimary}"
        FontFamily="Segoe UI, Segoe UI Variable Text, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStyle="None"
        StateChanged="ModelQuotaWindow_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" 
                      ResizeBorderThickness="6" 
                      GlassFrameThickness="1" 
                      CornerRadius="0" 
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Window Caption Button Base Style -->
        <Style x:Key="WindowCaptionBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="capBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="capBorder" Property="Background" Value="{DynamicResource ThemeSecondaryBtnHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="capBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Close Button Style (Modern Red Hover) -->
        <Style x:Key="WindowCloseBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="1,0,0,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="closeBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="closeBorder" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="closeBorder" Property="Background" Value="#C4101E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Rounded Quota Progress Bar Style -->
        <Style x:Key="ModelProgressBar" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Height" Value="6.5"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot" ClipToBounds="True">
                            <Border x:Name="PART_Track" Background="{DynamicResource ThemeCardSubBg}" CornerRadius="3.25"/>
                            <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left">
                                <Border Background="{TemplateBinding Foreground}" CornerRadius="3.25"/>
                            </Decorator>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Model Item Template with smooth hover and crystal-clear progress bar -->
        <DataTemplate x:Key="ModelQuotaItemTemplate">
            <Border Background="Transparent" CornerRadius="6" Padding="6,3.5" Margin="0,1,10,2"
                    ToolTip="{Binding TooltipText}" Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeCardHoverBg}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource ThemeTextPrimary}" 
                                   FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0">
                            <TextBlock Text="{Binding ResetCountdownText}" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right"
                                       Visibility="{Binding ResetCountdownVisibility}" Margin="0,0,0,1"/>
                            <TextBlock Text="{Binding PercentDisplay}" FontSize="11" Foreground="{Binding PercentForeground}" 
                                       FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                    <ProgressBar Style="{StaticResource ModelProgressBar}" 
                                 Value="{Binding PercentValue, Mode=OneWay}" 
                                 Foreground="{Binding BarBrush}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="MainRootBorder"
            Background="{DynamicResource ThemeWindowBg}"
            BorderBrush="{DynamicResource ThemeHeaderBorder}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.RenderTransform>
            <TranslateTransform x:Name="WindowTranslate" Y="0"/>
        </Border.RenderTransform>
        <Grid>
            <!-- Background subtle glow layer -->
            <Border Background="{DynamicResource ThemeWindowGlowBrush}" CornerRadius="10"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0: Custom Header (40px) -->
                    <RowDefinition Height="*"/>    <!-- 1: Body Content -->
                </Grid.RowDefinitions>

                <!-- 0. Header Bar (Integrated Custom Window Title Bar) -->
                <Border x:Name="MainHeaderBorder" Grid.Row="0" Background="{DynamicResource ThemeHeaderBg}" 
                        BorderBrush="{DynamicResource ThemeHeaderBorder}" BorderThickness="0,0,0,1" CornerRadius="9,9,0,0"
                        Height="40">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <!-- Left: Brand / Title + Badge -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Center: Drag spacer -->
                            <ColumnDefinition Width="*"/>
                            <!-- Right: Window Caption Buttons -->
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: App Title & Icon -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource ThemeCardSubBg}" Margin="0,0,8,0" 
                                    BorderBrush="{DynamicResource ThemeCardSubBorder}" BorderThickness="1">
                                <TextBlock Text="📊" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="TxtWinTitle" Text="Bảng Hạn Mức Model Quota" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource ThemeCardSubBg}" BorderBrush="{DynamicResource ThemeCardSubBorder}" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Antigravity IDE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource ThemeNavActiveFg}"/>
                            </Border>
                        </StackPanel>

                        <!-- Right: Window Caption Controls (Minimize, Maximize / Restore, Close) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                            <!-- Minimize Button -->
                            <Button x:Name="BtnWinMinimize" Style="{StaticResource WindowCaptionBtn}" Click="BtnWinMinimize_Click" ToolTip="Thu nhỏ">
                                <Path Data="M 0,5 L 10,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Button}}" StrokeThickness="1.2" Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Button>

                            <!-- Maximize / Restore Button -->
                            <Button x:Name="BtnWinMaximize" Style="{StaticResource WindowCaptionBtn}" Click="BtnWinMaximize_Click" ToolTip="Phóng to">
                                <Grid Width="10" Height="10">
                                    <Path x:Name="PathWinMaximize" Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Button}}" StrokeThickness="1.2" Width="10" Height="10"/>
                                    <Path x:Name="PathWinRestore" Data="M 2.5,0.5 L 9.5,0.5 L 9.5,7.5 M 0.5,2.5 L 7.5,2.5 L 7.5,9.5 L 0.5,9.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Button}}" StrokeThickness="1.2" Width="10" Height="10" Visibility="Collapsed"/>
                                </Grid>
                            </Button>

                            <!-- Close Button -->
                            <Button x:Name="BtnWinClose" Style="{StaticResource WindowCloseBtn}" Click="BtnWinClose_Click" ToolTip="Đóng">
                                <Path Data="M 0.5,0.5 L 9.5,9.5 M 9.5,0.5 L 0.5,9.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Button}}" StrokeThickness="1.2" Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 1. Body Content -->
                <Grid Grid.Row="1" Margin="22,14,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header (Account info + badges) -->
            <RowDefinition Height="Auto"/> <!-- Divider -->
            <RowDefinition Height="*"/>    <!-- Quotas: 5h and Weekly -->
            <RowDefinition Height="Auto"/> <!-- Footer status & actions -->
        </Grid.RowDefinitions>

        <!-- 1. Header: Avatar | Name | GOOGLE | Google AI Pro | Email | 0 credits | Refresh & Power switch -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Circular Avatar -->
            <Grid Grid.Column="0" Width="46" Height="46" Margin="0,0,14,0" VerticalAlignment="Center">
                <Border CornerRadius="23" Background="#543828">
                    <TextBlock x:Name="TxtInitial" Text="T" Foreground="#FFFFFF" FontWeight="Bold" 
                               FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="BorderAvatarImage" CornerRadius="23" Visibility="Collapsed">
                    <Border.Background>
                        <ImageBrush x:Name="ImgAvatar" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
            </Grid>

            <!-- Name, Badges, Email, Credits -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <!-- Line 1: Name + Badges -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtAccountName" Text="Toan Phung" FontSize="16.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                    
                    <!-- GOOGLE Badge -->
                    <Border Margin="10,0,6,0" CornerRadius="5" BorderBrush="#CBD5E1" BorderThickness="1" Padding="7,2" VerticalAlignment="Center">
                        <TextBlock Text="GOOGLE" FontSize="10" FontWeight="Bold" Foreground="#475569"/>
                    </Border>

                    <!-- Google AI Pro Badge -->
                    <Border x:Name="BorderPlanBadge" CornerRadius="5" Background="{DynamicResource ThemeCardSubBg}" BorderBrush="{DynamicResource ThemeCardSubBorder}" BorderThickness="1" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtPlanBadge" Text="Google AI Pro" FontSize="11" FontWeight="Black" Foreground="{DynamicResource ThemeTextSecondary}"/>
                    </Border>
                </StackPanel>

                <!-- Line 2: Email + 0 credits -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtAccountEmail" Text="wiksgemini@gmail.com" FontSize="12" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"/>
                    <TextBlock Text="  •  " FontSize="12" Foreground="#CBD5E1"/>
                    <TextBlock x:Name="TxtCredits" Text="0 credits" FontSize="12" Foreground="#0284C7" FontWeight="SemiBold" Cursor="Hand" 
                               ToolTip="Số AI Credits bổ sung có sẵn trong tài khoản" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Top Right: Switch / Power button + Quick refresh -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnRefreshQuota" Click="BtnRefreshQuota_Click" FocusVisualStyle="{x:Null}"
                        BorderThickness="1" Padding="12,6" Margin="0,0,8,0" Cursor="Hand" ToolTip="Đo lại hạn mức trực tiếp từ IDE">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource ThemeSecondaryBtnBg}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSecondaryBtnBorder}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeSecondaryBtnHoverBg}"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                                            </Trigger>
                                            <Trigger Property="IsFocused" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeCardHoverBg}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeCardHoverBg}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtRefreshIcon" Text="🔄" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="RefreshIconRotate" Angle="0"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="TxtRefreshText" Text="Đo lại Quota" FontSize="11.5" Foreground="{DynamicResource ThemeSecondaryBtnFg}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Power / Switch Icon Button -->
                <Button x:Name="BtnPowerSwitch" Click="BtnPowerSwitch_Click" FocusVisualStyle="{x:Null}"
                        Width="36" Height="36" Cursor="Hand" ToolTip="Kích hoạt chuyển ngay sang tài khoản này trong IDE"
                        BorderThickness="1">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource ThemeSecondaryBtnBg}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSecondaryBtnBorder}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeSecondaryBtnHoverBg}"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                                            </Trigger>
                                            <Trigger Property="IsFocused" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeCardHoverBg}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="⏻" FontSize="16" Foreground="{DynamicResource ThemeSecondaryBtnFg}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Separator -->
        <Border Grid.Row="1" Height="1" Background="{DynamicResource ThemeSeparator}" Margin="0,0,0,12"/>

        <!-- 2. Quotas: 5 giờ (3 columns) and Tuần (weekly) -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,2,0,4">
                <!-- Section: 5 giờ -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="65"/> <!-- Label: 5 giờ -->
                        <ColumnDefinition Width="*"/>  <!-- 3 columns of models -->
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource ThemeCardSubBg}" BorderBrush="{DynamicResource ThemeCardSubBorder}" BorderThickness="1" CornerRadius="5" Padding="6,3" 
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,5,0,0">
                        <TextBlock x:Name="Txt5HoursLabel" Text="5 giờ" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Column 1 -->
                        <ItemsControl Grid.Column="0" x:Name="ItemsCol1" ItemTemplate="{StaticResource ModelQuotaItemTemplate}"/>

                        <!-- Column 2 -->
                        <ItemsControl Grid.Column="1" x:Name="ItemsCol2" ItemTemplate="{StaticResource ModelQuotaItemTemplate}"/>

                        <!-- Column 3 -->
                        <ItemsControl Grid.Column="2" x:Name="ItemsCol3" ItemTemplate="{StaticResource ModelQuotaItemTemplate}"/>
                    </Grid>
                </Grid>

                <!-- Section: Tuần (Aligned with the same 3-column system) -->
                <Grid Margin="0,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="65"/> <!-- Label: Tuần -->
                        <ColumnDefinition Width="*"/>  <!-- Weekly models matching 3 columns -->
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource ThemeCardSubBg}" BorderBrush="{DynamicResource ThemeCardSubBorder}" BorderThickness="1" CornerRadius="5" Padding="6,3" 
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,5,0,0">
                        <TextBlock x:Name="TxtWeeklyLabel" Text="Tuần" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ItemsControl Grid.Column="0" Grid.ColumnSpan="3" x:Name="ItemsWeekly" ItemTemplate="{StaticResource ModelQuotaItemTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- 3. Footer: Reset Countdown & Status -->
        <Border Grid.Row="3" Background="{DynamicResource ThemeBottomBarBg}" BorderBrush="{DynamicResource ThemeBottomBarBorder}" BorderThickness="1" CornerRadius="8" Padding="14,9" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtResetSummary" Text="⏳ Hạn mức Claude/GPT sẽ hồi phục sau 4h 27m" FontSize="12" Foreground="#D97706" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtLastUpdated" Text="Cập nhật lúc: 15:45" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button x:Name="BtnClose" Grid.Column="1" Content="Đóng" Padding="20,6" 
                        Foreground="{DynamicResource ThemeSecondaryBtnFg}" FontWeight="SemiBold" 
                        BorderThickness="1" Cursor="Hand" Click="BtnClose_Click" VerticalAlignment="Center"
                        IsCancel="True" FocusVisualStyle="{x:Null}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource ThemeSecondaryBtnBg}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSecondaryBtnBorder}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeSecondaryBtnHoverBg}"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                                            </Trigger>
                                            <Trigger Property="IsFocused" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeCardHoverBg}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>

