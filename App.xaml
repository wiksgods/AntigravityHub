<Application x:Class="ProfileSwitchChrome.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Real Google Gemini Pro Avatar Gradient Ring (matches Image 2) -->
        <LinearGradientBrush x:Key="GeminiProRingBrush" StartPoint="0,1" EndPoint="1,0">
            <GradientStop Color="#1D4ED8" Offset="0.0"/>
            <GradientStop Color="#2563EB" Offset="0.25"/>
            <GradientStop Color="#3B82F6" Offset="0.5"/>
            <GradientStop Color="#8B5CF6" Offset="0.75"/>
            <GradientStop Color="#A855F7" Offset="0.9"/>
            <GradientStop Color="#DDD6FE" Offset="1.0"/>
        </LinearGradientBrush>
        <DropShadowEffect x:Key="GeminiProRingGlow" Color="#3B82F6" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/>

        <!-- Default Theme Resources (Dark fallback) -->
        <SolidColorBrush x:Key="ThemeWindowBg" Color="#080C14"/>
        <SolidColorBrush x:Key="ThemeHeaderBg" Color="#0B1321"/>
        <SolidColorBrush x:Key="ThemeHeaderBorder" Color="#1E293B"/>
        <SolidColorBrush x:Key="ThemeCardBg" Color="#101826"/>
        <SolidColorBrush x:Key="ThemeCardBorder" Color="#1B2537"/>
        <SolidColorBrush x:Key="ThemeCardSubBg" Color="#111A29"/>
        <SolidColorBrush x:Key="ThemeCardSubBorder" Color="#1E2A3C"/>
        <SolidColorBrush x:Key="ThemeCardHoverBg" Color="#162235"/>
        <SolidColorBrush x:Key="ThemeCardHoverBorder" Color="#2D415F"/>

        <SolidColorBrush x:Key="ThemeTextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="ThemeTextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="ThemeTextMuted" Color="#64748B"/>

        <SolidColorBrush x:Key="ThemeInputBg" Color="#0E1726"/>
        <SolidColorBrush x:Key="ThemeInputBorder" Color="#1E293B"/>

        <SolidColorBrush x:Key="ThemeToolbarBtnBg" Color="#0E1726"/>
        <SolidColorBrush x:Key="ThemeToolbarBtnBorder" Color="#1E293B"/>
        <SolidColorBrush x:Key="ThemeToolbarBtnHoverBg" Color="#162238"/>

        <SolidColorBrush x:Key="ThemeSecondaryBtnBg" Color="#162032"/>
        <SolidColorBrush x:Key="ThemeSecondaryBtnBorder" Color="#293548"/>
        <SolidColorBrush x:Key="ThemeSecondaryBtnFg" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="ThemeSecondaryBtnHoverBg" Color="#223048"/>

        <SolidColorBrush x:Key="ThemeBottomBarBg" Color="#0C1322"/>
        <SolidColorBrush x:Key="ThemeBottomBarBorder" Color="#1C273D"/>

        <SolidColorBrush x:Key="ThemeOptionCardBg" Color="#111A29"/>
        <SolidColorBrush x:Key="ThemeOptionCardBorder" Color="#1E2A3C"/>

        <SolidColorBrush x:Key="ThemeNavBg" Color="#09111D"/>
        <SolidColorBrush x:Key="ThemeNavBorder" Color="#1E2C42"/>
        <SolidColorBrush x:Key="ThemeNavActiveBg" Color="#1E293B"/>
        <SolidColorBrush x:Key="ThemeNavActiveFg" Color="#38BDF8"/>
        <SolidColorBrush x:Key="ThemeNavActiveBorder" Color="#0284C7"/>
        <SolidColorBrush x:Key="ThemeNavInactiveFg" Color="#94A3B8"/>
        <SolidColorBrush x:Key="ThemeNavInactiveHoverBg" Color="#141E2F"/>
        <SolidColorBrush x:Key="ThemeNavInactiveHoverFg" Color="#FFFFFF"/>

        <SolidColorBrush x:Key="ThemeContextMenuBg" Color="#0B1321"/>
        <SolidColorBrush x:Key="ThemeContextMenuBorder" Color="#1E293B"/>
        <SolidColorBrush x:Key="ThemeMenuItemHover" Color="#1E293B"/>
        <SolidColorBrush x:Key="ThemeSeparator" Color="#1E293B"/>

        <SolidColorBrush x:Key="ThemeStatusIndicatorBg" Color="#141E2F"/>
        <SolidColorBrush x:Key="ThemeStatusIndicatorBorder" Color="#24334C"/>
        <SolidColorBrush x:Key="ThemeStatusIndicatorFg" Color="#E2E8F0"/>

        <RadialGradientBrush x:Key="ThemeWindowGlowBrush" Center="0.5,0.0" GradientOrigin="0.5,0.0" RadiusX="0.9" RadiusY="0.5">
            <GradientStop Color="#182338" Offset="0"/>
            <GradientStop Color="#080C14" Offset="1"/>
        </RadialGradientBrush>
        <LinearGradientBrush x:Key="ThemeChromeHeroBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0C2340" Offset="0"/>
            <GradientStop Color="#0C1726" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ThemeAntigravityHeroBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0C2340" Offset="0"/>
            <GradientStop Color="#091424" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="ThemeHeroTitleFg" Color="#FFFFFF"/>
        <LinearGradientBrush x:Key="ThemeCardDefaultBg" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0C2340" Offset="0"/>
            <GradientStop Color="#0F1B2A" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="ThemeCardDefaultBorder" Color="#0284C7"/>

        <SolidColorBrush x:Key="ThemeProgressBarTrack" Color="#1E293B"/>
        <SolidColorBrush x:Key="ThemeGeminiLabelFg" Color="#38BDF8"/>
        <SolidColorBrush x:Key="ThemeClaudeLabelFg" Color="#C084FC"/>
        <SolidColorBrush x:Key="ThemeGeminiDisplayFg" Color="#7DD3FC"/>

        <SolidColorBrush x:Key="ThemeActiveStatusBadgeBg" Color="#1E293B"/>
        <SolidColorBrush x:Key="ThemeActiveStatusBadgeBorder" Color="#334155"/>
        <SolidColorBrush x:Key="ThemeActiveStatusBadgeFg" Color="#94A3B8"/>

        <SolidColorBrush x:Key="ThemeBottomNoticeBg" Color="#0B1321"/>
        <SolidColorBrush x:Key="ThemeBottomNoticeBorder" Color="#17253D"/>
        <SolidColorBrush x:Key="ThemeBottomNoticeTitleFg" Color="#38BDF8"/>
        <SolidColorBrush x:Key="ThemeBottomNoticeDescFg" Color="#64748B"/>

        <SolidColorBrush x:Key="ThemeAccountAvatarBg" Color="#1E293B"/>
        <SolidColorBrush x:Key="ThemeAccountAvatarBorder" Color="#334155"/>
        <SolidColorBrush x:Key="ThemeAccountAvatarFg" Color="#38BDF8"/>
        <SolidColorBrush x:Key="ThemeEmailFg" Color="#7DD3FC"/>
        <SolidColorBrush x:Key="ThemeModalBg" Color="#0F172A"/>
        <SolidColorBrush x:Key="ThemeModalBorder" Color="#24344D"/>

        <SolidColorBrush x:Key="ThemeHeroGeminiQuotaBg" Color="#0C4A6E"/>
        <SolidColorBrush x:Key="ThemeHeroGeminiQuotaBorder" Color="#0284C7"/>
        <SolidColorBrush x:Key="ThemeHeroGeminiQuotaFg" Color="#38BDF8"/>
        <SolidColorBrush x:Key="ThemeHeroGeminiQuotaValFg" Color="#BAE6FD"/>

        <SolidColorBrush x:Key="ThemeHeroClaudeQuotaBg" Color="#2E1065"/>
        <SolidColorBrush x:Key="ThemeHeroClaudeQuotaBorder" Color="#7C3AED"/>
        <SolidColorBrush x:Key="ThemeHeroClaudeQuotaFg" Color="#C084FC"/>
        <SolidColorBrush x:Key="ThemeHeroClaudeQuotaValFg" Color="#E9D5FF"/>

        <SolidColorBrush x:Key="ThemeActiveHeroBadgeBg" Color="#0C4A6E"/>
        <SolidColorBrush x:Key="ThemeActiveHeroBadgeBorder" Color="#0284C7"/>
        <SolidColorBrush x:Key="ThemeActiveHeroBadgeFg" Color="#38BDF8"/>

        <SolidColorBrush x:Key="ThemeDangerBtnBg" Color="#2E1010"/>
        <SolidColorBrush x:Key="ThemeDangerBtnBorder" Color="#991B1B"/>
        <SolidColorBrush x:Key="ThemeDangerBtnFg" Color="#FCA5A5"/>
        <SolidColorBrush x:Key="ThemeDangerBtnHoverBg" Color="#450A0A"/>

        <SolidColorBrush x:Key="ThemeScrollBarThumb" Color="#334155"/>
        <SolidColorBrush x:Key="ThemeScrollBarThumbHover" Color="#475569"/>

        <!-- Toast Notification Brushes -->
        <SolidColorBrush x:Key="ThemeToastBg" Color="#111A29"/>
        <SolidColorBrush x:Key="ThemeToastBorder" Color="#24334C"/>
        <SolidColorBrush x:Key="ThemeToastFg" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="ThemeToastCloseFg" Color="#94A3B8"/>
        <SolidColorBrush x:Key="ThemeToastCloseHoverBg" Color="#1E293B"/>

        <!-- Modern ScrollViewer ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="thumbBorder" Background="{DynamicResource ThemeScrollBarThumb}" CornerRadius="3" Margin="1,0,1,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource ThemeScrollBarThumbHover}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource ThemeNavActiveBorder}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Premium Dark/Light ContextMenu -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource ThemeContextMenuBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeContextMenuBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="MaxHeight" Value="340"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
                            </Border.Effect>
                            <ScrollViewer Focusable="False"
                                          CanContentScroll="False"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Premium Dark/Light MenuItem -->
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,6,12,6"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder" 
                                Background="Transparent" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}" 
                                Margin="2,1,2,1" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header" 
                                              RecognizesAccessKey="True" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeMenuItemHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Premium Dark/Light Separator -->
        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource ThemeSeparator}"/>
            <Setter Property="Margin" Value="4,3,4,3"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{TemplateBinding Background}" Height="1" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
